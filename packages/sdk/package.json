{
  "name": "@lumenwipe/sdk",
  "version": "0.10.0",
  "description": "Typed fetch client for the LumenWipe API - non-custodial Stellar account closing.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumenWipe/lumenwipe.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/LumenWipe/lumenwipe/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/LumenWipe/lumenwipe/issues",
  "keywords": [
    "stellar",
    "sdk",
    "wallet",
    "account-merge"
  ],
  "scripts": {
    "build": "bun run build:types && api-extractor run --local && cp dist/index.d.ts dist/index.d.cts",
    "build:types": "bun run --filter '@lumenwipe/types' build && tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json",
    "check-api": "api-extractor run",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "lint": "eslint src examples",
    "test": "bun test tests",
    "example:headless": "bun run examples/headless-close.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumenwipe/types": "workspace:*",
    "@microsoft/api-extractor": "^7.59.4",
    "@stellar/stellar-sdk": "17.2.1",
    "@types/bun": "^1.4.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
