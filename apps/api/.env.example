# For local dev: copy this file to `.env.local` (git-ignored) and fill in values.
# The API loads `.env.local` first, then `.env`.

# ── API authentication (#46) ────────────────────────────────────────────────
# Comma-separated `label=key` pairs. `label` is the integrator identity (used
# for metering); `key` is the secret they send as `Authorization: Bearer <key>`.
# Provisioning is manual for now (self-serve issuance is deferred). Generate a
# real key with e.g. `openssl rand -hex 32`. Quoted for readability (the value
# itself contains `=`); dotenv strips the quotes. In a hosting dashboard, set
# the value WITHOUT the surrounding quotes.
# Add a "playground" label for apps/playground - it gets its own independently-
# revocable, independently-rate-limited budget for free via the existing
# per-key ApiKeyThrottlerGuard (no code change needed).
API_KEYS='dev-local=abc123'

# ── Rate limiting (optional; per-API-key) ────────────────────────────────────
# Defaults: 120 requests per 60000 ms. Override per environment if needed.
# THROTTLE_LIMIT=120
# THROTTLE_TTL=60000

# ── Self-serve API keys (#289) ────────────────────────────────────────────────
# Backend model only for now: create/list/revoke/rotate are admin-only (the integrator-facing
# auth mechanism for true self-serve issuance is decided outside this repo). Both must be set
# together for the admin endpoints to be available.
#
# ADMIN_API_TOKEN: the operator secret for POST/GET /admin/api-keys/* (Authorization: Bearer
# <token>, distinct from any integrator API key). Generate with e.g. `openssl rand -hex 32`.
# ADMIN_API_TOKEN=
#
# FIRESTORE_PROJECT_ID: the GCP project holding the `apiKeys` Firestore collection (Native
# mode). No separate credentials needed on Cloud Run - the service account's IAM role
# (roles/datastore.user, granted outside this repo) authorizes access via Application Default
# Credentials. For local dev, set GOOGLE_APPLICATION_CREDENTIALS to a service account key, or
# run the Firestore emulator. Unset means self-serve keys fall back to an in-memory store that
# does not survive a restart - fine for local dev of everything else, not for production.
# FIRESTORE_PROJECT_ID=

# INTEGRATOR_AUTH_SECRET: signs the wallet sign-in challenge and session tokens for the
# self-service key page (/integrator/*). At least 32 characters; generate with e.g.
# `openssl rand -hex 32`. Needs FIRESTORE_PROJECT_ID as well. Rotating it signs everyone out.
# INTEGRATOR_AUTH_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3001

# ── Stellar RPC (Soroban) ────────────────────────────────────────────────────
STELLAR_RPC_TESTNET=
STELLAR_RPC_MAINNET=
# Optional custom auth header for a private RPC provider:
# STELLAR_RPC_HEADER_NAME_TESTNET=
# STELLAR_RPC_HEADER_VALUE_TESTNET=
# STELLAR_RPC_HEADER_NAME_MAINNET=
# STELLAR_RPC_HEADER_VALUE_MAINNET=

# ── Conversion path-finding (Horizon-compatible) ─────────────────────────────
PATH_ROUTING_API_TESTNET=
PATH_ROUTING_API_MAINNET=


# ── OctoPos (DeFi position detection, #146) ──────────────────────────────────
# Optional: unset means DeFi position detection is disabled and the tool falls back to a
# classic-only close (degraded mode). The public mainnet host is reachable unauthenticated
# at a free/IP rate-limit tier; OCTOPOS_API_KEY raises that to the authenticated tier.
# Mainnet only - OctoPos has no testnet deployment (its OpenAPI spec declares a testnet host,
# but the hostname does not resolve as of writing).
# OCTOPOS_API_URL_MAINNET=https://api-octopos-mainnet.untangled.finance
# OCTOPOS_API_KEY=

# ── Mediator (exchange forwarding co-sign) ───────────────────────────────────
# Public keys are validated against the secrets below. The secret is the only
# server-side signing key; keep it out of source control.
MEDIATOR_PUBLIC_TESTNET=
MEDIATOR_PUBLIC_MAINNET=
MEDIATOR_SECRET_TESTNET=
MEDIATOR_SECRET_MAINNET=

# ── Fee-bump sponsor (sponsored-fee closes, #164) ─────────────────────────────
# The one signing key: unlike the mediator, the browser never needs to recognize this
# account, so there is no public-key counterpart. Fund it to a small operational float
# only - the only thing it ever spends is its own XLM, on fees.
FEE_ACCOUNT_SECRET_TESTNET=
FEE_ACCOUNT_SECRET_MAINNET=

# NOTE (#59): the vars above were `NEXT_PUBLIC_`-prefixed until this cleanup - inherited
# from apps/web's own config/networks.ts (the domain was copied in #44), a prefix that means
# nothing in this standalone NestJS service. The API still reads the old `NEXT_PUBLIC_`-
# prefixed names as a fallback (with a startup warning) so an already-deployed environment
# using them keeps working; update it to the names above when convenient.

# ── Soroban token conversion (#161) ───────────────────────────────────────────
# The Soroswap API quotes and builds token-to-XLM swaps across Soroswap, Phoenix, Aquarius, and
# the classic order book. Key from https://api.soroswap.finance (sk_...). Without a key, or with
# the flag off, held Soroban tokens can be sent or left but never swapped. The API indexes no
# testnet protocol, so quotes there find no route.
SOROSWAP_API_URL=https://api.soroswap.finance
SOROSWAP_API_KEY=
SOROBAN_CONVERSION_ENABLED=false
XBULL_SWAP_API_URL=https://swap-api.xbull.io
XBULL_CONVERSION_ENABLED=false

# ── Soroban token discovery (#161) ────────────────────────────────────────────
# stellar.expert's public API proposes the Soroban token contracts an account may hold; every
# balance is re-read from the ledger. No key. Set to an empty value (STELLAR_EXPERT_API_URL=)
# to disable that source; lists, positions, and recent events still run.
STELLAR_EXPERT_API_URL=https://api.stellar.expert

# ── Funded integration tests (#286) ───────────────────────────────────────────
# Only read by tests/integration/{phoenix,fxdao}-exit-adapter.integration.test.ts, never by the
# server itself. Not needed for LUMENWIPE_RUN_INTEGRATION alone (that runs the read-only tier) -
# only when also setting LUMENWIPE_INTEGRATION_FUNDED to run `bun run test:integration` locally.
# PHOENIX_TESTNET_TOKEN_ADMIN_SECRET: admin of the project's own testnet Phoenix pool's token_a
# and fee_recipient - mints the test token each run's fixture account deposits as liquidity.
# PHOENIX_TESTNET_TOKEN_ADMIN_SECRET=
# FXDAO_TESTNET_ORACLE_ADMIN_SECRET: admin of the project's own testnet FxDAO oracle and vault -
# feeds a fresh price before each run opens its own vault fixture.
# FXDAO_TESTNET_ORACLE_ADMIN_SECRET=
