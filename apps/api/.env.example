# For local dev: copy this file to `.env.local` (git-ignored) and fill in values.
# The API loads `.env.local` first, then `.env`.

# ── API authentication (#46) ────────────────────────────────────────────────
# Comma-separated `label=key` pairs. `label` is the integrator identity (used
# for metering); `key` is the secret they send as `Authorization: Bearer <key>`.
# Provisioning is manual for now (self-serve issuance is deferred). Generate a
# real key with e.g. `openssl rand -hex 32`. Quoted for readability (the value
# itself contains `=`); dotenv strips the quotes. In a hosting dashboard, set
# the value WITHOUT the surrounding quotes.
# Add a "playground" label for apps/playground - it gets its own independently-
# revocable, independently-rate-limited budget for free via the existing
# per-key ApiKeyThrottlerGuard (no code change needed).
API_KEYS='dev-local=abc123'

# ── Rate limiting (optional; per-API-key) ────────────────────────────────────
# Defaults: 120 requests per 60000 ms. Override per environment if needed.
# THROTTLE_LIMIT=120
# THROTTLE_TTL=60000

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3001

# ── Stellar RPC (Soroban) ────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_RPC_TESTNET=
NEXT_PUBLIC_STELLAR_RPC_MAINNET=
# Optional custom auth header for a private RPC provider:
# NEXT_PUBLIC_STELLAR_RPC_HEADER_NAME_TESTNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_VALUE_TESTNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_NAME_MAINNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_VALUE_MAINNET=

# ── Horizon / classic reads ──────────────────────────────────────────────────
NEXT_PUBLIC_HORIZON_TESTNET=
NEXT_PUBLIC_HORIZON_MAINNET=

# ── Conversion path-finding (Horizon-compatible) ─────────────────────────────
NEXT_PUBLIC_PATH_ROUTING_API_TESTNET=
NEXT_PUBLIC_PATH_ROUTING_API_MAINNET=


# ── Mediator (exchange forwarding co-sign) ───────────────────────────────────
# Public keys are validated against the secrets below. The secret is the only
# server-side signing key; keep it out of source control.
NEXT_PUBLIC_MEDIATOR_PUBLIC_TESTNET=
NEXT_PUBLIC_MEDIATOR_PUBLIC_MAINNET=
MEDIATOR_SECRET_TESTNET=
MEDIATOR_SECRET_MAINNET=

# NOTE: the NEXT_PUBLIC_ prefixes are inherited from the web app (the domain was
# copied in #44). Renaming them for the standalone API is a separate cleanup.
