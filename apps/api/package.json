{
  "name": "@lumenwipe/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "bun test tests/unit tests/e2e",
    "test:coverage": "bun test tests/unit tests/e2e --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:integration": "LUMENWIPE_RUN_INTEGRATION=1 bun test --preload ./tests/setup-env.ts tests/integration",
    "test:adversarial": "bun test tests/adversarial",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@blend-capital/blend-sdk": "3.3.1",
    "@google-cloud/firestore": "^9.3.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@soroswap/sdk": "0.5.0",
    "@stellar/stellar-sdk": "17.3.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@lumenwipe/types": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.3"
  }
}
