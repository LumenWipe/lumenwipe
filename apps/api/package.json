{
  "name": "@lumenwipe/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "bun test tests/unit tests/e2e",
    "test:coverage": "bun test tests/unit tests/e2e --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:integration": "LUMENWIPE_RUN_INTEGRATION=1 bun test tests/integration",
    "test:adversarial": "bun test tests/adversarial",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@blend-capital/blend-sdk": "3.3.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@soroswap/sdk": "0.5.0",
    "@stellar/stellar-sdk": "16.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@lumenwipe/types": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "fast-check": "^4.9.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.3",
    "typescript": "^5.9.3"
  }
}
