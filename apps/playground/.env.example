# Server-side only - never NEXT_PUBLIC_-prefixed.
PLAYGROUND_ENCRYPTION_KEY=       # 64 hex chars (32 bytes) - openssl rand -hex 32
PLAYGROUND_ISSUER_SECRET_TESTNET=  # persistent LWDEMO asset issuer, testnet-only
PLAYGROUND_MM_SECRET_TESTNET=      # market maker: funds each demo, takes it back at the merge, testnet-only
PLAYGROUND_DISABLED_SCENARIOS=     # optional, comma-separated scenario ids to switch off (e.g. stale-offers)

# The daily reaper (app/api/cron/reap, scheduled in vercel.json). Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`. At least 16 letters and digits - openssl rand -hex 32.
# Without it the reaper answers 401 and no session is created, since nothing would reclaim it.
CRON_SECRET=
# Run it by hand: curl -H "Authorization: Bearer $CRON_SECRET" https://<playground host>/api/cron/reap
#
# Manual market maker top-up, if the reaper's faucet call keeps failing: Friendbot only funds a new
# account, so fund a throwaway and merge it into the market maker, e.g. with the stellar CLI:
#   stellar keys generate topup --network testnet --fund
#   stellar tx new account-merge --source-account topup --account <market maker public key> --network testnet
# New sessions are refused while the market maker holds under 500 spendable XLM; the reaper tops it
# up below 5000.

# Upstash Redis - session store (custodial secrets, encrypted at rest) and rate-limit counters.
# Provision a SEPARATE Upstash Redis database from apps/web's and paste ITS credentials here. Same
# variable names, different database: the playground holds demo secret keys, and sharing one store would
# mean a compromise of either app exposes the other's data. Never reuse apps/web's values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local development without Redis only: set to 1 to keep sessions in a private file (0600, in a
# 0700 directory under node_modules/.cache). Ignored by a production build and on Vercel, where a
# missing Redis means no sessions at all rather than custodial records on disk.
PLAYGROUND_DEV_FILE_STORE=

# The real LumenWipe API, called for the demolish step only
LUMENWIPE_API_URL=http://localhost:3001
LUMENWIPE_API_KEY=   # matches the "playground" label added to apps/api's API_KEYS

# The public key (G...) of the account the API's fee sponsor pays from, the one apps/api's
# FEE_ACCOUNT_SECRET_TESTNET holds. Never the secret. Every fee-bump envelope the sponsor returns
# must name it as its fee source; without a valid key the sponsored-fee scenario is unavailable.
PLAYGROUND_EXPECTED_FEE_ACCOUNT_TESTNET=

# The public key (G...) of the API's mediator, the one apps/api's MEDIATOR_SECRET_TESTNET holds
# (its MEDIATOR_PUBLIC_TESTNET). Never the secret. The exchange-close scenario sends a relay merge
# only once the mediator's co-signature verifies against it; without a valid key the scenario is
# unavailable. The API's own mediator check must also report the flow available.
PLAYGROUND_EXPECTED_MEDIATOR_TESTNET=
