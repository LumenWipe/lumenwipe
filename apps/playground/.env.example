# Server-side only - never NEXT_PUBLIC_-prefixed.
PLAYGROUND_ENCRYPTION_KEY=       # 64 hex chars (32 bytes) - openssl rand -hex 32
PLAYGROUND_ISSUER_SECRET_TESTNET=  # persistent LWDEMO asset issuer, testnet-only
PLAYGROUND_MM_SECRET_TESTNET=      # market-maker / merge-destination account, testnet-only

# Vercel KV - session store (custodial secrets, encrypted at rest) and rate-limit counters.
# Provision a SEPARATE KV store from apps/web's and paste ITS credentials here. Same variable
# names, different store: the playground holds demo secret keys, and sharing one store would
# mean a compromise of either app exposes the other's data. Never reuse apps/web's values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The real LumenWipe API, called for the demolish step only.
# Local dev runs the API on :3001; production points at https://api.lumenwipe.com.
LUMENWIPE_API_URL=http://localhost:3001
LUMENWIPE_API_KEY=   # matches the "playground" label added to apps/api's API_KEYS
