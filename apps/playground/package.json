{
  "name": "@lumenwipe/playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --filter '@lumenwipe/verify' build:js && next dev -p 3002",
    "build": "bun run --filter '@lumenwipe/verify' build && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "bun run --filter '@lumenwipe/verify' build && tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "bun run --filter '@lumenwipe/verify' build:js && bun test tests/unit",
    "test:e2e": "bun run --filter '@lumenwipe/verify' build:js && playwright test",
    "test:a11y": "bun run build && playwright test -c playwright.a11y.config.ts",
    "test:integration": "LUMENWIPE_RUN_INTEGRATION=1 bun test tests/integration",
    "durations": "bun scripts/durations.ts"
  },
  "dependencies": {
    "@lumenwipe/sdk": "workspace:*",
    "@lumenwipe/verify": "workspace:*",
    "@stellar/stellar-sdk": "17.4.0",
    "@upstash/redis": "^1.39.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
