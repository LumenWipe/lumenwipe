exports[`Spanish marketing copy landing renders the recorded markup 1`] = `"<script type="application/ld+json">{"@context":"https:\\u002f\\u002fschema.org","@graph":[{"@type":"Organization","@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f","logo":{"@type":"ImageObject","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fweb-app-manifest-512x512.png","width":512,"height":512},"sameAs":["https:\\u002f\\u002fgithub.com\\u002fLumenWipe\\u002flumenwipe"]},{"@type":"WebSite","@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fes#website","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fes","inLanguage":"es-419","publisher":{"@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization"}},{"@type":"WebApplication","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fes","description":"LumenWipe cierra una cuenta de Stellar de principio a fin y recupera el XLM bloqueado en sus reservas. Deshace trustlines, offers, data entries y posiciones de DeFi en Soroban, y luego envía el saldo con un merge a tu billetera. No custodial, de código abierto.","inLanguage":"es-419","applicationCategory":"FinanceApplication","operatingSystem":"Web Browser","isAccessibleForFree":true,"featureList":["Cierre de cuentas clásicas","Salidas de DeFi en Soroban","Inspector de autorizaciones","Sesiones reanudables","Plan determinista y auditable","Salidas de posiciones: Blend, Soroswap, Aquarius y Phoenix"],"publisher":{"@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization"}}]}</script><section class="mx-auto max-w-6xl px-5 pb-10 pt-16 text-center lg:px-8 lg:pt-20"><div class="mb-8 flex items-center justify-center gap-4"><span class="hidden h-px w-12 bg-white/15 sm:block"></span><span class="mkt-mono text-caption uppercase tracking-[0.18em] text-fg-subtle">Recupera tu XLM bloqueado</span><span class="hidden h-px w-12 bg-white/15 sm:block"></span></div><h1 class="mkt-display mx-auto max-w-[15ch] text-display font-extrabold leading-[0.95] text-white sm:text-6xl lg:text-hero">Cierra la cuenta. Quédate con los <span class="text-value">lumens.</span></h1><p class="mx-auto mt-6 max-w-xl text-body leading-relaxed text-white/70">Recupera el mínimo de 1 XLM que toda cuenta debe mantener, más 0.5 XLM por cada trustline (línea de confianza con un emisor de activos), offer (orden abierta en el libro de órdenes), data entry (dato guardado en la cuenta) y signer (firmante adicional de la cuenta). LumenWipe los elimina, sale de tus posiciones de DeFi, convierte los tokens sobrantes a XLM y envía el saldo a tu billetera con un merge (fusión que cierra la cuenta y envía su saldo). Firmas cada transacción en tu navegador.</p><div class="mt-8"><div class="w-full max-w-2xl mx-auto"><form><div class="space-y-1.5"><label for="_R_32_-control" class="block text-sm font-medium text-fg sr-only">Dirección de cuenta de Stellar</label><div class="relative flex gap-2 flex-col items-stretch sm:flex-row sm:items-center rounded-2xl border border-line-strong bg-white/[0.04] p-2 transition-colors has-[input[aria-invalid=true]]:border-danger has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-2 has-[input:focus-visible]:outline-focus"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search ml-2 hidden h-4 w-4 shrink-0 text-fg-disabled sm:block" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input type="text" placeholder="Pega una dirección de cuenta de Stellar - G…" spellCheck="false" autoComplete="off" autoCorrect="off" autoCapitalize="none" id="_R_32_-control" class="w-full rounded-control border-line-strong placeholder:text-fg-subtle transition-colors duration-fast ease-standard aria-[invalid=true]:border-danger disabled:cursor-not-allowed disabled:opacity-50 min-h-control min-w-0 flex-1 font-mono border-0 bg-transparent px-2 sm:px-0 sm:pr-2 text-body-sm text-white focus-visible:outline-none" value=""/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-control px-4 text-sm md:min-h-9 w-full shrink-0 sm:w-auto">Analizar la cuenta</button></div></div></form><p class="mt-2.5 text-center text-xs text-fg-subtle">Analiza en mainnet · solo lectura hasta que firmes · no necesitas una cuenta ·<!-- --> <button type="button" class="font-semibold text-white/80 underline underline-offset-2 hover:text-white">Estimar lo recuperable</button></p><p class="mt-2 text-center text-xs text-fg-muted">¿Todavía no estás listo?<!-- --> <a class="font-semibold text-accent underline underline-offset-2" href="/playground">Prueba el playground</a> <!-- -->con una cuenta desechable de testnet, sin billetera.</p><div role="status" aria-live="polite" class="sr-only"></div></div></div><div class="mt-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"><a class="group inline-flex items-center gap-1 font-semibold text-accent underline-offset-4 hover:underline" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="text-accent underline-offset-4 hover:underline" href="/es/how-it-works">Ver cómo funciona</a></div><div class="mkt-reveal  mt-12" style="transition-delay:120ms"><div class="mkt-card mx-auto max-w-4xl overflow-hidden text-left"><div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3.5 mkt-mono text-caption uppercase tracking-wider text-fg-subtle"><span>cuenta · GABC…WXYZ</span><span class="inline-flex items-center gap-2 text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent mkt-pulse"></span>analizando</span></div><div class="grid sm:grid-cols-[1.4fr_1fr]"><div class="p-4 sm:border-r sm:border-white/[0.06]"><div class="relative"><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-11 rounded-r-md border-l-2 border-l-[hsl(var(--accent))] bg-white/[0.04] transition-transform duration-300 ease-out" style="transform:translateY(0px)"></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white"><span class="mkt-mono w-5 text-caption text-fg-subtle">01</span><span>Normalizar signers</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+0.50</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">02</span><span>Borrar data entries</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+0.50</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">03</span><span>Cancelar offers abiertas</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+1.00</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">04</span><span>Convertir activos a XLM</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">-</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">05</span><span>Quitar trustlines</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+2.00</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">06</span><span>Hacer el merge al destino</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+1.00</span></div></div></div><div class="flex flex-col justify-center p-5"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-subtle">Reserva recuperable</span><div class="mkt-display mt-2 text-4xl font-extrabold text-value tabular-nums">0.00<!-- --> <span class="text-lg font-normal text-fg-subtle">XLM</span></div><div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-white/10"><span class="block h-full rounded-full bg-accent transition-[width] duration-500 ease-out" style="width:0%"></span></div><p class="mt-3 text-label leading-normal text-fg-muted">Cuenta de ejemplo · <!-- -->0<!-- --> de <!-- -->6<!-- --> pasos · <!-- -->5.00<!-- --> XLM en total</p></div></div></div></div></section><div class="border-y border-white/[0.07]"><dl class="mx-auto grid max-w-6xl grid-cols-1 divide-white/[0.07] px-5 sm:grid-cols-3 sm:divide-x lg:px-8"><div class="flex flex-col px-4 py-6 "><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">bloqueados en reserva por cuenta, donde un elemento es una trustline, una offer, un data entry o un signer</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">1 XLM más 0.5 por elemento</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">Dato de <!-- -->nov 2026<!-- --> ·<!-- --> <a href="https://developers.stellar.org/docs/learn/fundamentals/lumens#minimum-balance" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white">Fuente: <!-- -->Documentación de Stellar<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-col px-4 py-6 border-t border-white/[0.07] sm:border-t-0"><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">protocolos de DeFi con salida en mainnet</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">4</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">Del registro de contratos</dd></div><div class="flex flex-col px-4 py-6 border-t border-white/[0.07] sm:border-t-0"><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">última revisión de los contratos de los protocolos contra su código en producción</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">nov 2026</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">Del registro de contratos</dd></div></dl></div><section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>El problema</span><h2 class="mkt-display mt-4 max-w-2xl text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Tus lumens están bloqueados, y la salida es un laberinto.</h2><p class="mt-5 max-w-2xl text-body leading-relaxed text-white/70">Toda cuenta de Stellar mantiene XLM en reserva: 1 XLM por la cuenta, más 0.5 por cada trustline, offer, data entry y signer. Esa reserva solo se recupera cerrando la cuenta, y cerrarla de forma limpia es más difícil de lo que parece.</p></div><div class="mt-11 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]"><div class="mkt-reveal  mkt-card p-6" style="transition-delay:0ms"><div class="flex items-center justify-between"><span class="mkt-eyebrow text-fg-subtle">Reserva bloqueada</span><span class="mkt-mono text-caption text-fg-muted">Cuenta de ejemplo</span></div><div class="mt-5 space-y-3.5"><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">Mínimo de la cuenta</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">4 trustlines</span><span class="mkt-mono text-value tabular-nums">2.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:40%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">2 offers abiertas</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">1 data entry · 1 signer</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div></div><div class="mt-5 flex items-baseline justify-between border-t border-white/10 pt-4"><span class="text-sm font-semibold text-white">Total bloqueado</span><span class="mkt-display text-2xl font-bold text-value tabular-nums">5.00<!-- --> <span class="text-sm font-normal text-fg-muted">XLM</span></span></div></div><div class="grid gap-5"><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-5 w-5" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><div><h3 class="text-body font-semibold text-white">Un solo error y todo se revierte</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Un solo elemento sobrante hace fallar el merge final. Cada offer, posición, activo y elemento tiene que resolverse antes, en el orden correcto.</p></div></div><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-5 w-5" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><div><h3 class="text-body font-semibold text-white">Los exchanges no aceptan un merge</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Ningún exchange importante acepta un merge de cuenta como depósito. Si en su lugar envías tu XLM a un exchange con un pago, el mínimo de 1 XLM queda bloqueado en la cuenta.</p></div></div><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><div><h3 class="text-body font-semibold text-white">Las posiciones de DeFi se esconden fuera de la cuenta</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Un préstamo en Blend, la liquidez en Aquarius o una posición en Soroswap viven en el contrato del protocolo. Si haces el merge de la cuenta con una de ellas abierta, los fondos quedan varados allí, así que primero hay que salir de cada una a través de su propio contrato.</p></div></div></div></div></section><section class="mx-auto max-w-6xl border-t border-white/[0.07] px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>Lo que obtienes</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Hecho para la realidad desordenada de las cuentas reales.</h2></div><div class="mt-11 grid gap-4 lg:grid-cols-3"><div class="mkt-reveal  lg:col-span-2" style="transition-delay:0ms"><div class="mkt-card h-full p-6 [border-color:hsl(var(--accent)/0.25)]"><div class="flex items-start justify-between gap-4"><span class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><span class="rounded-full border border-accent/40 px-2.5 py-1 mkt-mono text-caption uppercase tracking-wider text-accent">Disponible</span></div><h3 class="mt-4 text-lg font-semibold text-white">Salidas de DeFi en Soroban</h3><p class="mt-2 max-w-md text-sm leading-relaxed text-white/70">Detecta las posiciones con OctoPos y sale de cada una con el adaptador de su propio protocolo: paga préstamos, retira liquidez y retira lo que está en staking, antes de quitar la trustline.</p><ul aria-label="Salidas de protocolos disponibles en mainnet" class="mt-5 flex flex-wrap gap-2" data-site-status="live"><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Blend</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Soroswap</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Aquarius</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Phoenix</li></ul><p class="mt-3 text-sm text-fg-muted" data-site-status="testnet-only">Solo en testnet<!-- -->: <!-- -->FxDAO</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-5 w-5" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Disponible</span></div><h3 class="mt-4 text-body font-semibold text-white">Inspector de autorizaciones</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Revisa cada autorización de tokens que tu cuenta otorgó a contratos de DeFi y revoca las riesgosas, incluso sin cerrar la cuenta.</p><a class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-accent underline-offset-4 hover:underline" href="/mainnet/allowances">Abrir el inspector de autorizaciones<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-fg-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-5 w-5" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-line-strong text-fg-muted">Solo en testnet</span></div><h3 class="mt-4 text-body font-semibold text-white">Cierre compatible con exchanges</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Una relay account (cuenta intermedia que reenvía el saldo) compartida recibe el merge y reenvía el saldo a la dirección de depósito de un exchange, con el memo (memo que identifica el depósito) que exige el exchange, en la misma transacción.</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-5 w-5" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Disponible</span></div><h3 class="mt-4 text-body font-semibold text-white">Sesiones reanudables</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Cierra la pestaña a mitad del proceso y retómalo en el mismo navegador: la cuenta se vuelve a leer y un plan nuevo cubre solo lo que falta, así que el trabajo confirmado no se repite.</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line h-5 w-5" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Disponible</span></div><h3 class="mt-4 text-body font-semibold text-white">Plan determinista y auditable</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">El mismo estado de la cuenta siempre produce el mismo plan ordenado: se puede probar, se puede revisar y nunca se arma con datos desactualizados.</p></div></div></div></section><section id="faq" class="mx-auto max-w-3xl scroll-mt-20 border-t border-white/[0.07] px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  text-center" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>Preguntas frecuentes</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display">Tus preguntas, respondidas.</h2><p class="mt-4 text-white/70">Cerrar una cuenta es irreversible. Así es exactamente como LumenWipe lo hace de forma segura.</p></div><div class="mt-10"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_m_-0-header" aria-controls="_R_m_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">¿LumenWipe es realmente no custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-0-panel" role="region" aria-labelledby="_R_m_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. <!-- -->Tu clave secreta nunca llega a un servidor de LumenWipe, y LumenWipe no la guarda ni la registra: firmas en tu navegador, con tu billetera o con una clave que se mantiene en memoria solo durante esta sesión.<!-- --> <!-- -->La API de LumenWipe lee tu cuenta y arma cada transacción sin firmar. Antes de que firmes, tu navegador la decodifica y compara sus operaciones y su destino con lo que ingresaste; si no coinciden, se detiene antes de pedirte la firma.<!-- --> <!-- -->Dos claves firman en el servidor, y ninguna de las dos puede firmar en nombre de tu cuenta.<!-- --> <span>Clave de la relay account<!-- -->: <!-- -->En un cierre hacia un exchange, solo cofirma una transacción de dos operaciones: el merge de tu cuenta hacia la relay account y un pago en XLM desde ella, en la misma transacción. Antes de que firmes, tu navegador verifica que ese pago vaya a la dirección del exchange que escribiste.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span><span>Clave del patrocinador de comisiones<!-- -->: <!-- -->Cuando se patrocina una comisión, solo firma el fee bump que paga la comisión de red de una transacción que ya firmaste, y no puede cambiar esa transacción.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span>La verificación es de código abierto:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a>.</p></div></div></div><div><button type="button" id="_R_m_-1-header" aria-controls="_R_m_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Se puede revertir el cierre de una cuenta?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-1-panel" role="region" aria-labelledby="_R_m_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. El merge final (fusión que cierra la cuenta y envía su saldo) elimina la cuenta del ledger de Stellar para siempre. Como la acción es irreversible, LumenWipe te muestra el plan completo desde el principio, simula cada paso y te pide una confirmación explícita (con la transacción en bruto disponible para revisar) antes de cada firma.</p></div></div></div><div><button type="button" id="_R_m_-2-header" aria-controls="_R_m_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Cuánto XLM voy a recuperar?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-2-panel" role="region" aria-labelledby="_R_m_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Todo lo que se puede recuperar. Stellar exige un saldo mínimo de <span class="text-value">1 XLM</span> <!-- -->(dos base reserves, la unidad de reserva que fija la red) más <span class="text-value">0.5 XLM</span> por cada subentry (elemento que bloquea reserva): cada trustline (línea de confianza con un emisor de activos), offer abierta (orden abierta en el libro de órdenes), data entry (dato guardado en la cuenta) y signer extra (firmante adicional de la cuenta). LumenWipe los deshace todos para liberar esas reservas, convierte los tokens sobrantes a XLM y envía el saldo completo a tu destino.</p></div></div></div><div><button type="button" id="_R_m_-3-header" aria-controls="_R_m_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Puedo enviar el XLM recuperado directo a un exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-3-panel" role="region" aria-labelledby="_R_m_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Por ahora, en testnet.<!-- --> Los exchanges no aceptan un merge como depósito, así que LumenWipe hace el merge final a través de una relay account (cuenta intermedia que reenvía el saldo): una cuenta compartida que recibe el merge y, en la misma transacción, paga el saldo a tu dirección de depósito con el memo correcto (memo que identifica el depósito). Los exchanges conocidos se validan contra un registro que exige el tipo de memo que cada uno requiere, para que los depósitos no se pierdan.<!-- --> En mainnet, el plan bloquea un cierre hacia un exchange hasta que la relay account esté desplegada ahí, así que por ahora cierra hacia una billetera que controles.</p></div></div></div><div><button type="button" id="_R_m_-4-header" aria-controls="_R_m_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Maneja posiciones de DeFi en Soroban?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-4-panel" role="region" aria-labelledby="_R_m_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. LumenWipe detecta las posiciones con OctoPos y sale de ellas en<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius y Phoenix</span> en mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only">las salidas de <span class="text-white/80">FxDAO</span> funcionan solo en testnet</span>. Las offers del libro de órdenes clásico se cancelan en cada cierre, y las pool shares (participaciones en un pool de liquidez AMM) clásicas se retiran por completo antes.</p></div></div></div><div><button type="button" id="_R_m_-5-header" aria-controls="_R_m_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué billeteras son compatibles?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-5-panel" role="region" aria-labelledby="_R_m_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Cualquier billetera que conecte Stellar Wallets Kit: Varial (antes Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect y más. Si tienes experiencia, también puedes usar un modo avanzado con tu clave secreta, en el que la clave se mantiene en memoria solo mientras dura el cierre, nunca se guarda ni se envía a un servidor, y se borra cuando terminas, cancelas, sales de la página o haces clic en el botón &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_m_-6-header" aria-controls="_R_m_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué pasa si cierro la pestaña a mitad del proceso?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-6-panel" role="region" aria-labelledby="_R_m_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Lo que ya se confirmó en la red queda hecho. Cuando confirmas el plan, este navegador guarda un pequeño registro del cierre: la cuenta, el destino, el memo y el hash de cualquier transacción que siga pendiente, nunca tus claves. Cuando vuelves en el mismo navegador, la página de inicio te ofrece retomarlo: LumenWipe vuelve a leer la cuenta y arma un plan nuevo con lo que falta, que revisas y firmas de nuevo, así que el trabajo confirmado no se repite. Si una transacción seguía esperando a la red, primero revisas cómo terminó. Tus decisiones para cada activo se guardan solo en esta pestaña, así que al recargarla las vuelves a ver para revisarlas; en otra pestaña, o cuando cierres esta, las tomas de nuevo.</p></div></div></div><div><button type="button" id="_R_m_-7-header" aria-controls="_R_m_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Mainnet o testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-7-panel" role="region" aria-labelledby="_R_m_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Las dos. Haz todo el flujo en testnet, sin fondos reales en riesgo, para ver exactamente qué va a pasar, y después cambia a mainnet para el cierre real.<!-- --> <span data-site-status="testnet-only">Los cierres hacia un exchange, las comisiones patrocinadas y las salidas de FxDAO funcionan solo en testnet por ahora.</span> Cerrar una cuenta en mainnet es irreversible y corre por tu cuenta y riesgo: revisa cada paso, el resultado de la simulación y la dirección de destino antes de firmar.</p></div></div></div></div></div><p class="mt-6 text-center text-sm text-fg-muted">¿Todavía tienes dudas?<!-- --> <a href="https://docs.lumenwipe.com" target="_blank" rel="noopener noreferrer" class="text-accent underline-offset-4 hover:underline">Lee la documentación completa</a>.</p></section><section class="mx-auto max-w-6xl px-5 pb-24 lg:px-8"><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card px-6 py-14 text-center sm:px-12 sm:py-20"><h2 class="mkt-display mx-auto max-w-2xl text-3xl font-bold leading-[1.05] text-white sm:text-5xl">Recupera el XLM que lleva tiempo bloqueado.</h2><p class="mx-auto mt-5 max-w-lg text-body text-white/70">Prueba todo el flujo en testnet sin arriesgar fondos y luego cambia a mainnet para el cierre real.</p><div class="mt-8 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm" href="/testnet">Probar en testnet</a></div><div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mkt-mono text-caption text-fg-muted"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Sin registro</span><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Firmado en tu navegador</span><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Código abierto</span></div></div></div></section>"`;

exports[`Spanish marketing copy faq renders the recorded markup 1`] = `"<section class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-24"><script type="application/ld+json">{"@context":"https:\\u002f\\u002fschema.org","@graph":[{"@type":"FAQPage","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fes\\u002ffaq","inLanguage":"es-419","mainEntity":[{"@type":"Question","name":"¿LumenWipe es realmente no custodial?","acceptedAnswer":{"@type":"Answer","text":"Sí. Tu clave secreta nunca llega a un servidor de LumenWipe, y LumenWipe no la guarda ni la registra: firmas en tu navegador, con tu billetera o con una clave que se mantiene en memoria solo durante esta sesión. La API de LumenWipe lee tu cuenta y arma cada transacción sin firmar. Antes de que firmes, tu navegador la decodifica y compara sus operaciones y su destino con lo que ingresaste; si no coinciden, se detiene antes de pedirte la firma. Dos claves firman en el servidor, y ninguna de las dos puede firmar en nombre de tu cuenta. Clave de la relay account: En un cierre hacia un exchange, solo cofirma una transacción de dos operaciones: el merge de tu cuenta hacia la relay account y un pago en XLM desde ella, en la misma transacción. Antes de que firmes, tu navegador verifica que ese pago vaya a la dirección del exchange que escribiste. Solo en testnet por ahora. Clave del patrocinador de comisiones: Cuando se patrocina una comisión, solo firma el fee bump que paga la comisión de red de una transacción que ya firmaste, y no puede cambiar esa transacción. Solo en testnet por ahora. La verificación es de código abierto: verify.ts."}},{"@type":"Question","name":"¿Se puede revertir el cierre de una cuenta?","acceptedAnswer":{"@type":"Answer","text":"No. El merge final (fusión que cierra la cuenta y envía su saldo) elimina la cuenta del ledger de Stellar para siempre. Como la acción es irreversible, LumenWipe te muestra el plan completo desde el principio, simula cada paso y te pide una confirmación explícita (con la transacción en bruto disponible para revisar) antes de cada firma."}},{"@type":"Question","name":"¿Cuánto XLM voy a recuperar?","acceptedAnswer":{"@type":"Answer","text":"Todo lo que se puede recuperar. Stellar exige un saldo mínimo de 1 XLM (dos base reserves, la unidad de reserva que fija la red) más 0.5 XLM por cada subentry (elemento que bloquea reserva): cada trustline (línea de confianza con un emisor de activos), offer abierta (orden abierta en el libro de órdenes), data entry (dato guardado en la cuenta) y signer extra (firmante adicional de la cuenta). LumenWipe los deshace todos para liberar esas reservas, convierte los tokens sobrantes a XLM y envía el saldo completo a tu destino."}},{"@type":"Question","name":"¿Puedo enviar el XLM recuperado directo a un exchange?","acceptedAnswer":{"@type":"Answer","text":"Por ahora, en testnet. Los exchanges no aceptan un merge como depósito, así que LumenWipe hace el merge final a través de una relay account (cuenta intermedia que reenvía el saldo): una cuenta compartida que recibe el merge y, en la misma transacción, paga el saldo a tu dirección de depósito con el memo correcto (memo que identifica el depósito). Los exchanges conocidos se validan contra un registro que exige el tipo de memo que cada uno requiere, para que los depósitos no se pierdan. En mainnet, el plan bloquea un cierre hacia un exchange hasta que la relay account esté desplegada ahí, así que por ahora cierra hacia una billetera que controles."}},{"@type":"Question","name":"¿Maneja posiciones de DeFi en Soroban?","acceptedAnswer":{"@type":"Answer","text":"Sí. LumenWipe detecta las posiciones con OctoPos y sale de ellas en Blend, Soroswap, Aquarius y Phoenix en mainnet; las salidas de FxDAO funcionan solo en testnet. Las offers del libro de órdenes clásico se cancelan en cada cierre, y las pool shares (participaciones en un pool de liquidez AMM) clásicas se retiran por completo antes."}},{"@type":"Question","name":"¿Qué billeteras son compatibles?","acceptedAnswer":{"@type":"Answer","text":"Cualquier billetera que conecte Stellar Wallets Kit: Varial (antes Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect y más. Si tienes experiencia, también puedes usar un modo avanzado con tu clave secreta, en el que la clave se mantiene en memoria solo mientras dura el cierre, nunca se guarda ni se envía a un servidor, y se borra cuando terminas, cancelas, sales de la página o haces clic en el botón \\"Forget key\\"."}},{"@type":"Question","name":"¿Qué pasa si cierro la pestaña a mitad del proceso?","acceptedAnswer":{"@type":"Answer","text":"Lo que ya se confirmó en la red queda hecho. Cuando confirmas el plan, este navegador guarda un pequeño registro del cierre: la cuenta, el destino, el memo y el hash de cualquier transacción que siga pendiente, nunca tus claves. Cuando vuelves en el mismo navegador, la página de inicio te ofrece retomarlo: LumenWipe vuelve a leer la cuenta y arma un plan nuevo con lo que falta, que revisas y firmas de nuevo, así que el trabajo confirmado no se repite. Si una transacción seguía esperando a la red, primero revisas cómo terminó. Tus decisiones para cada activo se guardan solo en esta pestaña, así que al recargarla las vuelves a ver para revisarlas; en otra pestaña, o cuando cierres esta, las tomas de nuevo."}},{"@type":"Question","name":"¿Mainnet o testnet?","acceptedAnswer":{"@type":"Answer","text":"Las dos. Haz todo el flujo en testnet, sin fondos reales en riesgo, para ver exactamente qué va a pasar, y después cambia a mainnet para el cierre real. Los cierres hacia un exchange, las comisiones patrocinadas y las salidas de FxDAO funcionan solo en testnet por ahora. Cerrar una cuenta en mainnet es irreversible y corre por tu cuenta y riesgo: revisa cada paso, el resultado de la simulación y la dirección de destino antes de firmar."}}]}]}</script><div class="text-center"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>Preguntas frecuentes</span><h1 class="mkt-display mt-4 text-4xl font-bold text-white sm:text-5xl">Tus preguntas, respondidas.</h1><p class="mx-auto mt-4 max-w-xl text-white/70">Cerrar una cuenta es irreversible. Así es exactamente como LumenWipe lo hace de forma segura.</p></div><div class="mt-12"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_3_-0-header" aria-controls="_R_3_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">¿LumenWipe es realmente no custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-0-panel" role="region" aria-labelledby="_R_3_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. <!-- -->Tu clave secreta nunca llega a un servidor de LumenWipe, y LumenWipe no la guarda ni la registra: firmas en tu navegador, con tu billetera o con una clave que se mantiene en memoria solo durante esta sesión.<!-- --> <!-- -->La API de LumenWipe lee tu cuenta y arma cada transacción sin firmar. Antes de que firmes, tu navegador la decodifica y compara sus operaciones y su destino con lo que ingresaste; si no coinciden, se detiene antes de pedirte la firma.<!-- --> <!-- -->Dos claves firman en el servidor, y ninguna de las dos puede firmar en nombre de tu cuenta.<!-- --> <span>Clave de la relay account<!-- -->: <!-- -->En un cierre hacia un exchange, solo cofirma una transacción de dos operaciones: el merge de tu cuenta hacia la relay account y un pago en XLM desde ella, en la misma transacción. Antes de que firmes, tu navegador verifica que ese pago vaya a la dirección del exchange que escribiste.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span><span>Clave del patrocinador de comisiones<!-- -->: <!-- -->Cuando se patrocina una comisión, solo firma el fee bump que paga la comisión de red de una transacción que ya firmaste, y no puede cambiar esa transacción.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span>La verificación es de código abierto:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a>.</p></div></div></div><div><button type="button" id="_R_3_-1-header" aria-controls="_R_3_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Se puede revertir el cierre de una cuenta?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-1-panel" role="region" aria-labelledby="_R_3_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. El merge final (fusión que cierra la cuenta y envía su saldo) elimina la cuenta del ledger de Stellar para siempre. Como la acción es irreversible, LumenWipe te muestra el plan completo desde el principio, simula cada paso y te pide una confirmación explícita (con la transacción en bruto disponible para revisar) antes de cada firma.</p></div></div></div><div><button type="button" id="_R_3_-2-header" aria-controls="_R_3_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Cuánto XLM voy a recuperar?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-2-panel" role="region" aria-labelledby="_R_3_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Todo lo que se puede recuperar. Stellar exige un saldo mínimo de <span class="text-value">1 XLM</span> <!-- -->(dos base reserves, la unidad de reserva que fija la red) más <span class="text-value">0.5 XLM</span> por cada subentry (elemento que bloquea reserva): cada trustline (línea de confianza con un emisor de activos), offer abierta (orden abierta en el libro de órdenes), data entry (dato guardado en la cuenta) y signer extra (firmante adicional de la cuenta). LumenWipe los deshace todos para liberar esas reservas, convierte los tokens sobrantes a XLM y envía el saldo completo a tu destino.</p></div></div></div><div><button type="button" id="_R_3_-3-header" aria-controls="_R_3_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Puedo enviar el XLM recuperado directo a un exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-3-panel" role="region" aria-labelledby="_R_3_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Por ahora, en testnet.<!-- --> Los exchanges no aceptan un merge como depósito, así que LumenWipe hace el merge final a través de una relay account (cuenta intermedia que reenvía el saldo): una cuenta compartida que recibe el merge y, en la misma transacción, paga el saldo a tu dirección de depósito con el memo correcto (memo que identifica el depósito). Los exchanges conocidos se validan contra un registro que exige el tipo de memo que cada uno requiere, para que los depósitos no se pierdan.<!-- --> En mainnet, el plan bloquea un cierre hacia un exchange hasta que la relay account esté desplegada ahí, así que por ahora cierra hacia una billetera que controles.</p></div></div></div><div><button type="button" id="_R_3_-4-header" aria-controls="_R_3_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Maneja posiciones de DeFi en Soroban?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-4-panel" role="region" aria-labelledby="_R_3_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. LumenWipe detecta las posiciones con OctoPos y sale de ellas en<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius y Phoenix</span> en mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only">las salidas de <span class="text-white/80">FxDAO</span> funcionan solo en testnet</span>. Las offers del libro de órdenes clásico se cancelan en cada cierre, y las pool shares (participaciones en un pool de liquidez AMM) clásicas se retiran por completo antes.</p></div></div></div><div><button type="button" id="_R_3_-5-header" aria-controls="_R_3_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué billeteras son compatibles?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-5-panel" role="region" aria-labelledby="_R_3_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Cualquier billetera que conecte Stellar Wallets Kit: Varial (antes Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect y más. Si tienes experiencia, también puedes usar un modo avanzado con tu clave secreta, en el que la clave se mantiene en memoria solo mientras dura el cierre, nunca se guarda ni se envía a un servidor, y se borra cuando terminas, cancelas, sales de la página o haces clic en el botón &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_3_-6-header" aria-controls="_R_3_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué pasa si cierro la pestaña a mitad del proceso?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-6-panel" role="region" aria-labelledby="_R_3_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Lo que ya se confirmó en la red queda hecho. Cuando confirmas el plan, este navegador guarda un pequeño registro del cierre: la cuenta, el destino, el memo y el hash de cualquier transacción que siga pendiente, nunca tus claves. Cuando vuelves en el mismo navegador, la página de inicio te ofrece retomarlo: LumenWipe vuelve a leer la cuenta y arma un plan nuevo con lo que falta, que revisas y firmas de nuevo, así que el trabajo confirmado no se repite. Si una transacción seguía esperando a la red, primero revisas cómo terminó. Tus decisiones para cada activo se guardan solo en esta pestaña, así que al recargarla las vuelves a ver para revisarlas; en otra pestaña, o cuando cierres esta, las tomas de nuevo.</p></div></div></div><div><button type="button" id="_R_3_-7-header" aria-controls="_R_3_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Mainnet o testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-7-panel" role="region" aria-labelledby="_R_3_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Las dos. Haz todo el flujo en testnet, sin fondos reales en riesgo, para ver exactamente qué va a pasar, y después cambia a mainnet para el cierre real.<!-- --> <span data-site-status="testnet-only">Los cierres hacia un exchange, las comisiones patrocinadas y las salidas de FxDAO funcionan solo en testnet por ahora.</span> Cerrar una cuenta en mainnet es irreversible y corre por tu cuenta y riesgo: revisa cada paso, el resultado de la simulación y la dirección de destino antes de firmar.</p></div></div></div></div></div><div class="mt-10 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://docs.lumenwipe.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm">Leer la documentación</a></div></section>"`;

exports[`Spanish marketing copy security renders the recorded markup 1`] = `"<section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24"><div class="max-w-2xl"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>Modelo de confianza</span><h1 class="mkt-display mt-4 text-4xl font-bold text-white sm:text-5xl">El límite de confianza es tu navegador.</h1><p class="mt-5 text-body leading-relaxed text-white/70">LumenWipe arma transacciones que vacían cuentas de forma irreversible, así que el diseño parte de ese hecho. <!-- -->Tu clave secreta nunca llega a un servidor de LumenWipe, y LumenWipe no la guarda ni la registra: firmas en tu navegador, con tu billetera o con una clave que se mantiene en memoria solo durante esta sesión.<!-- --> <!-- -->La API de LumenWipe lee tu cuenta y arma cada transacción sin firmar. Antes de que firmes, tu navegador la decodifica y compara sus operaciones y su destino con lo que ingresaste; si no coinciden, se detiene antes de pedirte la firma.</p><p class="mt-4 text-body leading-relaxed text-white/70">La verificación es de código abierto:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">lee verify.ts en GitHub<span class="sr-only"> (se abre en una pestaña nueva)</span></a>. Los exchanges y las reglas de memo (memo que identifica el depósito) con los que compara, y los protocolos de los que puede salir, están en el<!-- --> <a class="text-accent underline underline-offset-4" href="/registry">registro de exchanges</a>.</p></div><div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16"><div class="space-y-2.5"><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-accent/40 bg-accent/[0.06]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">Tu navegador</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Billetera · verificación de transacciones · firma · sesión</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-white">tu clave se queda aquí</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">API de LumenWipe</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Lecturas de la cuenta · adaptadores de DeFi · arma transacciones sin firmar · claves de la relay account (cuenta intermedia que reenvía el saldo) y del patrocinador de comisiones</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-fg-subtle">nunca tiene tu clave</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">Red de Stellar y datos</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Stellar RPC · Horizon · Soroswap API</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-fg-subtle">lectura · simulación · envío</span></div><p class="mkt-mono flex items-center gap-2 pt-2 text-caption text-fg-subtle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Tu clave se queda en tu navegador</p></div><ul class="overflow-hidden rounded-2xl border border-white/10"><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round h-4 w-4" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><div><div class="text-sm font-semibold text-white">Clave privada</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Nunca se transmite. Se queda en tu billetera, o en memoria solo mientras dura el cierre, nunca se guarda y se borra cuando terminas, cancelas o sales de la página.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/signer.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signer.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/hooks/useActiveSigner.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">useActiveSigner.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/execution-wizard.test.tsx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">execution-wizard.test.tsx<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/signer.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signer.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line h-4 w-4" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><div><div class="text-sm font-semibold text-white">Cada paso destructivo</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Se confirma de forma explícita antes de firmar. El plan completo se muestra desde el inicio, una decisión destructiva solo vale para el destino o la cuenta exactos que aceptaste, y tu navegador verifica cada transacción antes de que tu billetera te pida aprobarla.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/api/close-decisions.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">close-decisions.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/hooks/useCloseExecution.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">useCloseExecution.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/close-decisions.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">close-decisions.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/signing-guards.test.tsx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signing-guards.test.tsx<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-4 w-4" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><div><div class="text-sm font-semibold text-white">Memo del exchange</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Es obligatorio y se valida contra un registro de exchanges conocidos que exige el tipo de memo; si falta el memo, el envío se bloquea para que los depósitos no se pierdan.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/exchange-registry/index.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">index.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/plan/memo-requirement.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">memo-requirement.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/memo-requirement.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">memo-requirement.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/exchange-registry.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">exchange-registry.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server h-4 w-4" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></span><div><div class="text-sm font-semibold text-white">Si la API se ve comprometida</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">No tiene ninguna clave que pueda firmar en nombre de tu cuenta, y tu navegador verifica las operaciones y el destino de cada transacción que arma antes de que firmes. Las cifras que tu navegador solo puede tomar de las propias lecturas de la API, como una cotización de conversión, se te muestran para que las aceptes.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/mediator/mediator-signing.service.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediator-signing.service.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify-conformance.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify-conformance.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/mediator-validation.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediator-validation.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-network h-4 w-4" aria-hidden="true"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg></span><div><div class="text-sm font-semibold text-white">CSP estricta</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Los scripts no tienen unsafe-inline ni unsafe-eval: un script inline de la página solo se ejecuta si la política lo nombra, por su hash en las páginas prerenderizadas y con un nonce por solicitud en las demás. Las dependencias están fijadas en el lockfile y CI busca en ellas vulnerabilidades conocidas, y la app web no tiene código que arme transacciones: una regla de lint lo impide.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/proxy.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">proxy.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/config/marketing-csp.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.mjs<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/scripts/marketing-csp.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.mjs<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/scripts/audit-gate.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">audit-gate.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/eslint.config.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">eslint.config.mjs<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/proxy.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">proxy.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/marketing-csp.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/scripts/audit-gate.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">audit-gate.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/boundary-lint.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">boundary-lint.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></div></li></ul></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Claves en el servidor</h2><p class="mt-3 text-body leading-relaxed text-white/70">Dos claves firman en el servidor, y ninguna de las dos puede firmar en nombre de tu cuenta.</p><dl class="mt-5 space-y-4"><div class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Clave de la relay account</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">En un cierre hacia un exchange, solo cofirma una transacción de dos operaciones: el merge de tu cuenta hacia la relay account y un pago en XLM desde ella, en la misma transacción. Antes de que firmes, tu navegador verifica que ese pago vaya a la dirección del exchange que escribiste.<!-- --> <!-- -->Solo en testnet por ahora.</dd></div><div class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Clave del patrocinador de comisiones</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Cuando se patrocina una comisión, solo firma el fee bump que paga la comisión de red de una transacción que ya firmaste, y no puede cambiar esa transacción.<!-- --> <!-- -->Solo en testnet por ahora.</dd></div></dl></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Lo que cuesta un cierre</h2><p class="mt-3 text-body leading-relaxed text-white/70">LumenWipe no cobra nada por un cierre. Sus comisiones van a la red de Stellar, y una conversión de tokens que eliges paga la comisión del agregador dentro de su cotización. Cada fila nombra el código que fija o rechaza el cargo.</p><dl class="mt-5 space-y-4"><div data-fee="network" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Comisión de red</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">La comisión base de Stellar, 100 stroops (0.00001 XLM) por operación, que se paga a la red. Una salida de DeFi paga en su lugar la comisión que informa su simulación, y tu navegador rechaza una que supere un tope fijo.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/config/constants.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">constants.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/close-api/plan-fee.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">plan-fee.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/plan-fee.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">plan-fee.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></dd></div><div data-fee="service" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Comisión de servicio</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Ninguna. Tu navegador rechaza una transacción que lleve cualquier operación que no sepa describir, así que no se puede añadir ningún cargo a un cierre.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></dd></div><div data-fee="sponsored" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Comisiones patrocinadas</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Cuando el patrocinador de comisiones está configurado, paga la comisión de red de cada transacción del cierre que su regla acepta, con un fee bump; esa transacción no lleva comisión propia. Solo en testnet por ahora.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/fee-bump/fee-bump.controller.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">fee-bump.controller.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/fee-bump-controller.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">fee-bump-controller.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></dd></div><div data-fee="relay" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Relay account (cierres hacia exchanges)</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Tu cuenta se fusiona con una relay account compartida que, en la misma transacción, reenvía el saldo al exchange con tu memo. El reenvío es el saldo menos la comisión de red de esa transacción, 200 stroops por sus dos operaciones, y tu navegador rechaza un reenvío que quede por debajo del saldo que leyó en más de un pequeño margen. Solo en testnet por ahora.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/stellar/tx-builder/merge.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">merge.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/mediatorMerge.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediatorMerge.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></dd></div><div data-fee="conversion" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Conversión de tokens</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Opcional. Un token que eliges convertir se intercambia a través del agregador de Soroswap, cuya propia comisión ya está en la cotización que aceptas. Un intercambio que nombra un socio de comisiones (fee partner) lo rechazan la API y tu navegador.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Se aplica en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/close-api/token-conversion-round.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">token-conversion-round.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Se prueba en</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a></dd></div></dl></dd></div></dl></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Cómo verificar la versión que estás usando</h2><p class="mt-3 text-body leading-relaxed text-white/70">Esta versión no lleva hash de commit: solo lo fija un despliegue hecho desde el repositorio.</p><p class="mt-3 text-body leading-relaxed text-white/70">La app web se despliega de forma continua desde main y no tiene etiqueta de versión, así que el commit es su versión.</p></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Reportar una vulnerabilidad</h2><p class="mt-3 text-body leading-relaxed text-white/70">Escribe a<!-- --> <a href="mailto:security@lumenwipe.com" class="text-accent underline underline-offset-4">security@lumenwipe.com</a> y no abras un issue público. El alcance, los tiempos de respuesta y el proceso de divulgación están en<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">SECURITY.md<span class="sr-only"> (se abre en una pestaña nueva)</span></a>; el mismo contacto se publica en<!-- --> <a href="/.well-known/security.txt" class="mkt-mono text-accent underline underline-offset-4">/.well-known/security.txt</a>.</p></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Reportes de seguridad</h2><p class="mt-3 text-body leading-relaxed text-white/70">Qué se ha revisado, quién lo hizo y qué encontró: la página de reportes lista cada reporte de seguridad publicado y, mientras no exista ninguno, los documentos de autoevaluación que hay hoy.</p><p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-body"><a class="text-accent underline underline-offset-4" href="/es/security/reports">Ver los reportes de seguridad</a></p></div><div class="mt-12 flex flex-wrap items-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://docs.lumenwipe.com/architecture" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm">Leer el modelo de seguridad</a></div></section>"`;

exports[`Spanish marketing copy how it works renders the recorded markup 1`] = `"<section class="mx-auto max-w-4xl px-5 pb-14 pt-16 text-center lg:px-8 lg:pt-24"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Cómo funciona</span><h1 class="mkt-display mx-auto mt-5 max-w-3xl text-display font-extrabold leading-[1.02] text-white sm:text-6xl">Un plan determinista para una acción irreversible.</h1><p class="mx-auto mt-6 max-w-2xl text-body leading-relaxed text-white/85">Cerrar una cuenta toma una o más transacciones en el orden correcto. LumenWipe te muestra el plan completo desde el inicio y luego lo ejecuta una transacción a la vez, cada una confirmada antes de la siguiente, volviendo a leer el estado en vivo y simulando antes de cada firma, para que nunca se firme nada con datos desactualizados.</p><div class="mt-8 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm" href="/es/faq">Ir a las preguntas frecuentes</a></div></div></section><section class="border-y border-white/8 bg-white/[0.012]"><div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-20"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>El ciclo de ejecución</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-4xl">Cada paso sigue el mismo ciclo seguro.</h2><p class="mt-4 leading-relaxed text-white/85">Ningún paso confía en un valor guardado en caché. Cada uno se concilia con el ledger en vivo, se simula y espera tu aprobación explícita antes de firmar un solo byte.</p></div><div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"><div class="mkt-reveal  " style="transition-delay:0ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-4 w-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Volver a leer el estado en vivo</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">getLedgerEntries</p></div></div><div class="mkt-reveal  " style="transition-delay:60ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Simular</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">simulateTransaction</p></div></div><div class="mkt-reveal  " style="transition-delay:120ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Confirmar</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">tú lo apruebas</p></div></div><div class="mkt-reveal  " style="transition-delay:180ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool h-4 w-4" aria-hidden="true"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Firmar en el navegador</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">tu billetera</p></div></div><div class="mkt-reveal  " style="transition-delay:240ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4 w-4" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Enviar el XDR</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">a Stellar RPC</p></div></div><div class="mkt-reveal  " style="transition-delay:300ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Consultar y avanzar</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">siguiente paso</p></div></div></div><p class="mt-5 inline-flex items-center gap-2 mkt-mono text-xs text-fg-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="m17 2 4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path d="m7 22-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg>se repite en cada paso del plan</p></div></section><section class="mx-auto max-w-4xl px-5 py-20 lg:px-8 lg:py-28"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>El plan</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Ocho pasos ordenados, con cada reserva contabilizada.</h2></div><ol class="mt-12 space-y-3"><li class="mkt-reveal  " style="transition-delay:0ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search h-5 w-5" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">01</span><h3 class="text-base font-semibold text-white">Analizar la cuenta</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Enumera cada subentry (elemento que bloquea reserva): trustlines (líneas de confianza con un emisor de activos), offers (órdenes abiertas en el libro de órdenes), data entries (datos guardados en la cuenta) y signers (firmantes adicionales de la cuenta), y detecta las posiciones de DeFi con OctoPos. El resultado es un único plan de ejecución ordenado.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>Horizon + Stellar RPC</div></div></div></li><li class="mkt-reveal  " style="transition-delay:40ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round h-5 w-5" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">02</span><h3 class="text-base font-semibold text-white">Normalizar los signers</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Quita los signers adicionales y restablece los umbrales para que una sola clave pueda autorizar todos los pasos restantes sin sorpresas a mitad del flujo.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>SetOptions</div></div></div></li><li class="mkt-reveal  " style="transition-delay:80ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database h-5 w-5" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">03</span><h3 class="text-base font-semibold text-white">Quitar los data entries</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Borra cada data entry con ManageData, por lotes, y libera 0.5 XLM de reserva por cada uno.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ManageData (value = null)</div></div></div></li><li class="mkt-reveal  " style="transition-delay:120ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x lucide-x-circle h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">04</span><h3 class="text-base font-semibold text-white">Cancelar las offers del DEX</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Cierra todas las offers abiertas del libro de órdenes y libera la reserva que bloquea cada una.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ManageSellOffer / ManageBuyOffer · amount = 0</div></div></div></li><li class="mkt-reveal  " style="transition-delay:160ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">05</span><h3 class="text-base font-semibold text-white">Salir de las posiciones de DeFi</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Sale de cada posición en un protocolo de Soroban compatible, pagando préstamos y retirando lo que está en staking primero cuando hace falta, con el adaptador propio de cada protocolo. Las pool shares (participaciones en un pool de liquidez AMM) clásicas se retiran por completo.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>InvokeHostFunction · Blend · Soroswap · Aquarius · Phoenix</div></div></div></li><li class="mkt-reveal  " style="transition-delay:200ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right h-5 w-5" aria-hidden="true"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">06</span><h3 class="text-base font-semibold text-white">Convertir los activos a XLM</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Cambia cada token restante a XLM por la mejor ruta disponible entre los mercados de Soroban y los clásicos.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>Soroswap API · SDEX path payments</div></div></div></li><li class="mkt-reveal  " style="transition-delay:240ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-unlink h-5 w-5" aria-hidden="true"><path d="m18.84 12.25 1.72-1.71h-.02a5.004 5.004 0 0 0-.12-7.07 5.006 5.006 0 0 0-6.95 0l-1.72 1.71"></path><path d="m5.17 11.75-1.71 1.71a5.004 5.004 0 0 0 .12 7.07 5.006 5.006 0 0 0 6.95 0l1.71-1.71"></path><line x1="8" x2="8" y1="2" y2="5"></line><line x1="2" x2="5" y1="8" y2="8"></line><line x1="16" x2="16" y1="19" y2="22"></line><line x1="19" x2="22" y1="16" y2="16"></line></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">07</span><h3 class="text-base font-semibold text-white">Quitar las trustlines</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Cuando un saldo queda en cero, quita su trustline y libera los 0.5 XLM de reserva.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ChangeTrust · limit = 0</div></div></div></li><li class="mkt-reveal  " style="transition-delay:280ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-merge h-5 w-5" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 9 9"></path></svg></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">08</span><h3 class="text-base font-semibold text-white">Hacer el merge de la cuenta</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Ejecuta el merge (fusión que cierra la cuenta y envía su saldo) final, directo a una billetera o a través de una relay account (cuenta intermedia que reenvía el saldo) si el destino es un exchange. La base reserve (unidad de reserva que fija la red) también vuelve.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>AccountMerge</div></div></div></li></ol></section><section class="border-y border-white/8 bg-white/[0.012]"><div class="mx-auto max-w-5xl px-5 py-20 lg:px-8 lg:py-28"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Destinos en exchanges</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">El flujo de relay para exchanges centralizados.</h2><p class="mt-5 leading-relaxed text-white/85">Los exchanges no admiten<!-- --> <span class="mkt-mono text-white/80">ACCOUNT_MERGE</span>. LumenWipe resuelve esto con una sola relay account compartida: el merge envía tu saldo a ella y, en la misma transacción, ella reenvía ese saldo a tu dirección de depósito con el memo (memo que identifica el depósito). Su clave se queda en la API de LumenWipe, que solo cofirma ese pago, y tu navegador verifica que el pago vaya a la dirección que escribiste antes de que firmes.</p></div><div class="mkt-reveal  " style="transition-delay:100ms"><div class="mkt-panel mt-10 rounded-2xl p-6 sm:p-8"><div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="flex-1 rounded-xl border p-4 text-center border-white/12 bg-white/[0.03]"><div class="text-sm font-semibold text-white">Cuenta de origen</div><div class="mt-1 text-caption text-fg-muted">la cuenta que estás cerrando</div></div><div class="flex flex-row items-center justify-center gap-2 text-fg-muted sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-4 w-4 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down h-4 w-4 sm:hidden" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg><span class="mkt-mono text-caption uppercase tracking-wider text-fg-muted">AccountMerge</span></div><div class="flex-1 rounded-xl border p-4 text-center border-accent/40 bg-accent/[0.06]"><div class="text-sm font-semibold text-white">Relay account</div><div class="mt-1 text-caption text-fg-muted">compartida · cofirmada por la API</div></div><div class="flex flex-row items-center justify-center gap-2 text-fg-muted sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-4 w-4 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down h-4 w-4 sm:hidden" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg><span class="mkt-mono text-caption uppercase tracking-wider text-fg-muted">Payment + memo</span></div><div class="flex-1 rounded-xl border p-4 text-center border-white/12 bg-white/[0.03]"><div class="text-sm font-semibold text-white">Depósito en el exchange</div><div class="mt-1 text-caption text-fg-muted">dirección y memo validados</div></div></div><p class="mt-6 text-center text-sm text-fg-muted">La relay account reenvía todo tu saldo menos una comisión de red de dos operaciones, así que nada de tu reserva se queda atrás, y la revisión te muestra el exchange y la ruta por la relay account antes de que firmes. Los exchanges conocidos se validan contra un registro que exige el tipo de memo correcto.</p></div></div></div></section><section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-12 lg:grid-cols-2 lg:gap-16"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Reanudable por diseño</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-3xl">Cierra la pestaña. Retoma donde lo dejaste.</h2><p class="mt-4 leading-relaxed text-white/85">El cierre pasa por estas fases en tu navegador. Una vez que confirmas el plan, el navegador guarda un pequeño registro del cierre, nunca tus claves. Cuando vuelves, LumenWipe vuelve a leer la cuenta y arma un plan nuevo con lo que falta, que revisas y firmas de nuevo, así que el trabajo ya confirmado no se repite.</p><div class="mt-7 flex flex-wrap items-center gap-2"><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Idle</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Analyzing</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">PreflightComplete</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">StepExecuting</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">StepConfirmed</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Complete</span></span></div></div><div class="mkt-reveal  " style="transition-delay:100ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Arquitectura</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-3xl">Tres capas, un límite de confianza.</h2><p class="mt-4 leading-relaxed text-white/85">Sin un indexador propio. Cada fuente de lectura está detrás de un adaptador, así que se puede cambiar por cualquier proveedor compatible sin tocar el resto del sistema.</p><div class="mt-7 space-y-2.5"><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-accent/40 bg-accent/[0.06]"><div class="min-w-0"><div class="text-sm font-semibold text-white">Navegador</div><div class="truncate mkt-mono text-caption text-fg-muted">UI · billetera · verificación de transacciones · firma · sesión</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-white">tu clave se queda aquí</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0"><div class="text-sm font-semibold text-white">API de LumenWipe</div><div class="truncate mkt-mono text-caption text-fg-muted">lecturas · adaptadores de DeFi · rutas · arma transacciones sin firmar</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-fg-muted">nunca tiene tu clave</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0"><div class="text-sm font-semibold text-white">Red de Stellar</div><div class="truncate mkt-mono text-caption text-fg-muted">Stellar RPC · Horizon · Soroswap</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-fg-muted">lectura · envío</span></div></div></div></div></section><section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-5 pb-24 lg:px-8"><div class="mkt-reveal  text-center" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Preguntas frecuentes</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-4xl">Tus preguntas, respondidas.</h2></div><div class="mt-10"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_m_-0-header" aria-controls="_R_m_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">¿LumenWipe es realmente no custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-0-panel" role="region" aria-labelledby="_R_m_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. <!-- -->Tu clave secreta nunca llega a un servidor de LumenWipe, y LumenWipe no la guarda ni la registra: firmas en tu navegador, con tu billetera o con una clave que se mantiene en memoria solo durante esta sesión.<!-- --> <!-- -->La API de LumenWipe lee tu cuenta y arma cada transacción sin firmar. Antes de que firmes, tu navegador la decodifica y compara sus operaciones y su destino con lo que ingresaste; si no coinciden, se detiene antes de pedirte la firma.<!-- --> <!-- -->Dos claves firman en el servidor, y ninguna de las dos puede firmar en nombre de tu cuenta.<!-- --> <span>Clave de la relay account<!-- -->: <!-- -->En un cierre hacia un exchange, solo cofirma una transacción de dos operaciones: el merge de tu cuenta hacia la relay account y un pago en XLM desde ella, en la misma transacción. Antes de que firmes, tu navegador verifica que ese pago vaya a la dirección del exchange que escribiste.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span><span>Clave del patrocinador de comisiones<!-- -->: <!-- -->Cuando se patrocina una comisión, solo firma el fee bump que paga la comisión de red de una transacción que ya firmaste, y no puede cambiar esa transacción.<!-- --> <!-- -->Solo en testnet por ahora.<!-- --> </span>La verificación es de código abierto:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (se abre en una pestaña nueva)</span></a>.</p></div></div></div><div><button type="button" id="_R_m_-1-header" aria-controls="_R_m_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Se puede revertir el cierre de una cuenta?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-1-panel" role="region" aria-labelledby="_R_m_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. El merge final (fusión que cierra la cuenta y envía su saldo) elimina la cuenta del ledger de Stellar para siempre. Como la acción es irreversible, LumenWipe te muestra el plan completo desde el principio, simula cada paso y te pide una confirmación explícita (con la transacción en bruto disponible para revisar) antes de cada firma.</p></div></div></div><div><button type="button" id="_R_m_-2-header" aria-controls="_R_m_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Cuánto XLM voy a recuperar?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-2-panel" role="region" aria-labelledby="_R_m_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Todo lo que se puede recuperar. Stellar exige un saldo mínimo de <span class="text-value">1 XLM</span> <!-- -->(dos base reserves, la unidad de reserva que fija la red) más <span class="text-value">0.5 XLM</span> por cada subentry (elemento que bloquea reserva): cada trustline (línea de confianza con un emisor de activos), offer abierta (orden abierta en el libro de órdenes), data entry (dato guardado en la cuenta) y signer extra (firmante adicional de la cuenta). LumenWipe los deshace todos para liberar esas reservas, convierte los tokens sobrantes a XLM y envía el saldo completo a tu destino.</p></div></div></div><div><button type="button" id="_R_m_-3-header" aria-controls="_R_m_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Puedo enviar el XLM recuperado directo a un exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-3-panel" role="region" aria-labelledby="_R_m_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Por ahora, en testnet.<!-- --> Los exchanges no aceptan un merge como depósito, así que LumenWipe hace el merge final a través de una relay account (cuenta intermedia que reenvía el saldo): una cuenta compartida que recibe el merge y, en la misma transacción, paga el saldo a tu dirección de depósito con el memo correcto (memo que identifica el depósito). Los exchanges conocidos se validan contra un registro que exige el tipo de memo que cada uno requiere, para que los depósitos no se pierdan.<!-- --> En mainnet, el plan bloquea un cierre hacia un exchange hasta que la relay account esté desplegada ahí, así que por ahora cierra hacia una billetera que controles.</p></div></div></div><div><button type="button" id="_R_m_-4-header" aria-controls="_R_m_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Maneja posiciones de DeFi en Soroban?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-4-panel" role="region" aria-labelledby="_R_m_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Sí. LumenWipe detecta las posiciones con OctoPos y sale de ellas en<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius y Phoenix</span> en mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only">las salidas de <span class="text-white/80">FxDAO</span> funcionan solo en testnet</span>. Las offers del libro de órdenes clásico se cancelan en cada cierre, y las pool shares (participaciones en un pool de liquidez AMM) clásicas se retiran por completo antes.</p></div></div></div><div><button type="button" id="_R_m_-5-header" aria-controls="_R_m_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué billeteras son compatibles?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-5-panel" role="region" aria-labelledby="_R_m_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Cualquier billetera que conecte Stellar Wallets Kit: Varial (antes Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect y más. Si tienes experiencia, también puedes usar un modo avanzado con tu clave secreta, en el que la clave se mantiene en memoria solo mientras dura el cierre, nunca se guarda ni se envía a un servidor, y se borra cuando terminas, cancelas, sales de la página o haces clic en el botón &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_m_-6-header" aria-controls="_R_m_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Qué pasa si cierro la pestaña a mitad del proceso?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-6-panel" role="region" aria-labelledby="_R_m_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Lo que ya se confirmó en la red queda hecho. Cuando confirmas el plan, este navegador guarda un pequeño registro del cierre: la cuenta, el destino, el memo y el hash de cualquier transacción que siga pendiente, nunca tus claves. Cuando vuelves en el mismo navegador, la página de inicio te ofrece retomarlo: LumenWipe vuelve a leer la cuenta y arma un plan nuevo con lo que falta, que revisas y firmas de nuevo, así que el trabajo confirmado no se repite. Si una transacción seguía esperando a la red, primero revisas cómo terminó. Tus decisiones para cada activo se guardan solo en esta pestaña, así que al recargarla las vuelves a ver para revisarlas; en otra pestaña, o cuando cierres esta, las tomas de nuevo.</p></div></div></div><div><button type="button" id="_R_m_-7-header" aria-controls="_R_m_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">¿Mainnet o testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-7-panel" role="region" aria-labelledby="_R_m_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Las dos. Haz todo el flujo en testnet, sin fondos reales en riesgo, para ver exactamente qué va a pasar, y después cambia a mainnet para el cierre real.<!-- --> <span data-site-status="testnet-only">Los cierres hacia un exchange, las comisiones patrocinadas y las salidas de FxDAO funcionan solo en testnet por ahora.</span> Cerrar una cuenta en mainnet es irreversible y corre por tu cuenta y riesgo: revisa cada paso, el resultado de la simulación y la dirección de destino antes de firmar.</p></div></div></div></div></div><div class="mt-12 flex flex-col items-center gap-4 rounded-2xl border border-white/10 bg-surface p-8 text-center"><h3 class="mkt-display text-xl font-bold text-white">Empieza cuando quieras.</h3><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Abrir la app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section>"`;

exports[`Spanish marketing copy nav renders the recorded markup 1`] = `"<header class="sticky top-0 z-50 transition-colors duration-300 border-b border-transparent"><nav aria-label="Principal" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:px-8"><a aria-label="Inicio de LumenWipe" class="shrink-0" href="/es"><span class="inline-flex items-center gap-2.5"><svg viewBox="0 0 32 32" fill="none" class="h-7 w-auto" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="8" stroke="hsl(var(--accent))" stroke-opacity="0.35" stroke-width="1.25"></rect><path d="M7 22c4.5 3 13.5 3 18 0" stroke="hsl(var(--value))" stroke-opacity="0.9" stroke-width="1.5" stroke-linecap="round"></path><path d="M16 6.5c.7 4.2 2.3 5.8 6.5 6.5-4.2.7-5.8 2.3-6.5 6.5-.7-4.2-2.3-5.8-6.5-6.5 4.2-.7 5.8-2.3 6.5-6.5Z" fill="hsl(var(--accent))"></path></svg><span class="mkt-display text-body font-bold tracking-tight text-white max-[359px]:sr-only">Lumen<span class="text-accent">Wipe</span></span></span></a><div class="hidden items-center gap-7 lg:flex"><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="/es/how-it-works">Cómo funciona<span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="/es/security">Seguridad<span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition