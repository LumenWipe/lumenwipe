exports[`English copy of the stats, registry, playground and content pages and the blog index stats renders the recorded markup 1`] = `"<div class="mx-auto max-w-6xl space-y-5 px-5 pb-24 pt-12 lg:px-8"><div class="mkt-reveal  " style="transition-delay:0ms"><div class="flex items-center justify-between"><div><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>On-chain activity</span><h1 class="mkt-display mt-3 text-3xl font-bold text-white sm:text-4xl">Real numbers. Verifiable on Stellar.</h1><p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">Every transaction on this page is an<!-- --> <code class="rounded bg-white/5 px-1 py-0.5 mkt-mono text-label text-white/75">ACCOUNT_MERGE</code> <!-- -->operation recorded on the Stellar blockchain. Click any hash to verify.</p></div></div></div><div class="mkt-reveal  " style="transition-delay:60ms"><div class="grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="flex flex-col gap-1.5 rounded-2xl border border-white/8 bg-white/[0.025] px-6 py-5"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-subtle">Accounts closed on mainnet</span><div class="mkt-display text-4xl font-bold leading-none text-white sm:text-5xl"><span class="inline-block h-10 w-28 animate-pulse rounded-lg bg-white/8"></span></div></div><div class="flex flex-col gap-1.5 rounded-2xl border border-white/8 bg-white/[0.025] px-6 py-5"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-subtle">XLM recovered on mainnet</span><div class="mkt-display text-4xl font-bold leading-none text-white sm:text-5xl"><span class="inline-block h-10 w-28 animate-pulse rounded-lg bg-white/8"></span></div><span class="mkt-mono text-caption text-fg-subtle">From reserves released on-chain</span></div><div class="flex flex-col gap-1.5 rounded-2xl border border-white/8 bg-white/[0.025] px-6 py-5"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-subtle">Avg per mainnet close</span><div class="mkt-display text-4xl font-bold leading-none text-white sm:text-5xl"><span class="inline-block h-10 w-28 animate-pulse rounded-lg bg-white/8"></span></div><span class="mkt-mono text-caption text-fg-subtle">Mean XLM recovered per mainnet close</span></div></div></div><div class="mkt-reveal  " style="transition-delay:100ms"><div class="grid gap-5 lg:grid-cols-[1.2fr_0.8fr]"><div class="relative overflow-hidden rounded-2xl border border-white/8 bg-white/[0.02]"><div class="flex items-center justify-between border-b border-white/8 px-4 py-3"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-muted">Each close · last <!-- -->60<!-- --> days</span><span class="mkt-mono text-caption text-fg-subtle">size = XLM recovered · gold = large close</span></div><div class="relative"><svg viewBox="0 0 900 176" width="100%" height="auto" aria-label="Constellation of account closes over time" style="display:block"><defs><filter id="star-glow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur><feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter><filter id="star-glow-lg" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="5" result="blur"></feGaussianBlur><feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><line x1="16" y1="18" x2="16" y2="164" stroke="rgba(255,255,255,0.04)" stroke-width="1"></line><line x1="160.66666666666666" y1="18" x2="160.66666666666666" y2="164" stroke="rgba(255,255,255,0.04)" stroke-width="1"></line><line x1="305.3333333333333" y1="18" x2="305.3333333333333" y2="164" stroke="rgba(255,255,255,0.04)" stroke-width="1"></line><line x1="450" y1="18" x2="450" y2="164" stroke="rgba(255,255,255,0.04)" stroke-width="1"></line><line x1="594.6666666666666" y1="18" x2="594.6666666666666" y2="164" stroke="rgba(255,255,255,0.04