exports[`English marketing copy landing renders the recorded markup 1`] = `"<script type="application/ld+json">{"@context":"https:\\u002f\\u002fschema.org","@graph":[{"@type":"Organization","@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f","logo":{"@type":"ImageObject","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002fweb-app-manifest-512x512.png","width":512,"height":512},"sameAs":["https:\\u002f\\u002fgithub.com\\u002fLumenWipe\\u002flumenwipe"]},{"@type":"WebSite","@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#website","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f","inLanguage":"en","publisher":{"@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization"}},{"@type":"WebApplication","name":"LumenWipe","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f","description":"LumenWipe closes a Stellar account end to end and recovers the XLM locked in its reserves. Unwind trustlines, offers, data entries and Soroban DeFi positions, then merge out to your wallet. Non-custodial, open source.","inLanguage":"en","applicationCategory":"FinanceApplication","operatingSystem":"Web Browser","isAccessibleForFree":true,"featureList":["Classic account close","Soroban DeFi exits","Allowance inspector","Resumable sessions","Deterministic, auditable plan","Position exits: Blend, Soroswap, Aquarius and Phoenix"],"publisher":{"@id":"https:\\u002f\\u002fwww.lumenwipe.com\\u002f#organization"}}]}</script><section class="mx-auto max-w-6xl px-5 pb-10 pt-16 text-center lg:px-8 lg:pt-20"><div class="mb-8 flex items-center justify-center gap-4"><span class="hidden h-px w-12 bg-white/15 sm:block"></span><span class="mkt-mono text-caption uppercase tracking-[0.18em] text-fg-subtle">Recover your locked XLM</span><span class="hidden h-px w-12 bg-white/15 sm:block"></span></div><h1 class="mkt-display mx-auto max-w-[15ch] text-display font-extrabold leading-[0.95] text-white sm:text-6xl lg:text-hero">Close the account. Keep the <span class="text-value">lumens.</span></h1><p class="mx-auto mt-6 max-w-xl text-body leading-relaxed text-white/70">Get back the 1 XLM every account must hold, plus 0.5 XLM for each trustline, offer, data entry and signer. LumenWipe clears them, exits your DeFi positions, converts leftover tokens to XLM and merges the balance into your wallet. You sign every transaction in your browser.</p><div class="mt-8"><div class="w-full max-w-2xl mx-auto"><form><div class="space-y-1.5"><label for="_R_32_-control" class="block text-sm font-medium text-fg sr-only">Stellar account address</label><div class="relative flex gap-2 flex-col items-stretch sm:flex-row sm:items-center rounded-2xl border border-line-strong bg-white/[0.04] p-2 transition-colors has-[input[aria-invalid=true]]:border-danger has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-2 has-[input:focus-visible]:outline-focus"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search ml-2 hidden h-4 w-4 shrink-0 text-fg-disabled sm:block" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input type="text" placeholder="Paste a Stellar account address - G…" spellCheck="false" autoComplete="off" autoCorrect="off" autoCapitalize="none" id="_R_32_-control" class="w-full rounded-control border-line-strong placeholder:text-fg-subtle transition-colors duration-fast ease-standard aria-[invalid=true]:border-danger disabled:cursor-not-allowed disabled:opacity-50 min-h-control min-w-0 flex-1 font-mono border-0 bg-transparent px-2 sm:px-0 sm:pr-2 text-body-sm text-white focus-visible:outline-none" value=""/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-control px-4 text-sm md:min-h-9 w-full shrink-0 sm:w-auto">Analyze account</button></div></div></form><p class="mt-2.5 text-center text-xs text-fg-subtle">Analyzes on mainnet · read-only until you sign · no account needed ·<!-- --> <button type="button" class="font-semibold text-white/80 underline underline-offset-2 hover:text-white">Estimate recovery</button></p><p class="mt-2 text-center text-xs text-fg-muted">Not ready yet?<!-- --> <a class="font-semibold text-accent underline underline-offset-2" href="/playground">Try the playground</a> <!-- -->with a throwaway testnet account, no wallet needed.</p><div role="status" aria-live="polite" class="sr-only"></div></div></div><div class="mt-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"><a class="group inline-flex items-center gap-1 font-semibold text-accent underline-offset-4 hover:underline" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="text-accent underline-offset-4 hover:underline" href="/how-it-works">See how it works</a></div><div class="mkt-reveal  mt-12" style="transition-delay:120ms"><div class="mkt-card mx-auto max-w-4xl overflow-hidden text-left"><div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3.5 mkt-mono text-caption uppercase tracking-wider text-fg-subtle"><span>account · GABC…WXYZ</span><span class="inline-flex items-center gap-2 text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent mkt-pulse"></span>scanning</span></div><div class="grid sm:grid-cols-[1.4fr_1fr]"><div class="p-4 sm:border-r sm:border-white/[0.06]"><div class="relative"><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-11 rounded-r-md border-l-2 border-l-[hsl(var(--accent))] bg-white/[0.04] transition-transform duration-300 ease-out" style="transform:translateY(0px)"></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white"><span class="mkt-mono w-5 text-caption text-fg-subtle">01</span><span>Normalize signers</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+0.50</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">02</span><span>Clear data entries</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+0.50</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">03</span><span>Cancel open offers</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+1.00</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">04</span><span>Convert assets to XLM</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">-</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">05</span><span>Remove trustlines</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+2.00</span></div><div class="relative z-10 flex h-11 items-center gap-3 border-t border-t-white/[0.06] px-3 text-body-sm transition-colors duration-500 first:border-t-0 text-white/70"><span class="mkt-mono w-5 text-caption text-fg-subtle">06</span><span>Merge to destination</span><span class="mkt-mono ml-auto tabular-nums transition-colors duration-500 text-fg-subtle">+1.00</span></div></div></div><div class="flex flex-col justify-center p-5"><span class="mkt-mono text-caption uppercase tracking-wider text-fg-subtle">Recoverable reserve</span><div class="mkt-display mt-2 text-4xl font-extrabold text-value tabular-nums">0.00<!-- --> <span class="text-lg font-normal text-fg-subtle">XLM</span></div><div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-white/10"><span class="block h-full rounded-full bg-accent transition-[width] duration-500 ease-out" style="width:0%"></span></div><p class="mt-3 text-label leading-normal text-fg-muted">Example account · <!-- -->0<!-- --> of <!-- -->6<!-- --> steps · <!-- -->5.00<!-- --> XLM total</p></div></div></div></div></section><div class="border-y border-white/[0.07]"><dl class="mx-auto grid max-w-6xl grid-cols-1 divide-white/[0.07] px-5 sm:grid-cols-3 sm:divide-x lg:px-8"><div class="flex flex-col px-4 py-6 "><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">locked in reserve per account, where an item is a trustline, offer, data entry or signer</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">1 XLM plus 0.5 per item</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">As of <!-- -->Nov 2026<!-- --> ·<!-- --> <a href="https://developers.stellar.org/docs/learn/fundamentals/lumens#minimum-balance" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white">Source: <!-- -->Stellar docs<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-col px-4 py-6 border-t border-white/[0.07] sm:border-t-0"><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">DeFi protocols with a mainnet exit</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">4</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">From the contract registry</dd></div><div class="flex flex-col px-4 py-6 border-t border-white/[0.07] sm:border-t-0"><dt class="order-2 mt-1 text-label leading-snug text-fg-muted">protocol contracts last checked against their live code</dt><dd class="order-1 mkt-display text-2xl font-bold text-white sm:text-3xl">Nov 2026</dd><dd class="order-3 mt-2 mkt-mono text-caption text-fg-muted">From the contract registry</dd></div></dl></div><section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>The problem</span><h2 class="mkt-display mt-4 max-w-2xl text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Your lumens are locked, and the exit is a maze.</h2><p class="mt-5 max-w-2xl text-body leading-relaxed text-white/70">Every Stellar account holds XLM in reserve: 1 XLM for the account, plus 0.5 for every trustline, offer, data entry and signer. That reserve is only recoverable by closing the account, and closing one cleanly is harder than it sounds.</p></div><div class="mt-11 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]"><div class="mkt-reveal  mkt-card p-6" style="transition-delay:0ms"><div class="flex items-center justify-between"><span class="mkt-eyebrow text-fg-subtle">Locked reserve</span><span class="mkt-mono text-caption text-fg-muted">Example account</span></div><div class="mt-5 space-y-3.5"><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">Account minimum</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">4 trustlines</span><span class="mkt-mono text-value tabular-nums">2.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:40%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">2 open offers</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div><div><div class="flex items-baseline justify-between text-sm"><span class="text-white/75">1 data entry · 1 signer</span><span class="mkt-mono text-value tabular-nums">1.00</span></div><div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]"><div class="h-full rounded-full bg-value" style="width:20%"></div></div></div></div><div class="mt-5 flex items-baseline justify-between border-t border-white/10 pt-4"><span class="text-sm font-semibold text-white">Total locked</span><span class="mkt-display text-2xl font-bold text-value tabular-nums">5.00<!-- --> <span class="text-sm font-normal text-fg-muted">XLM</span></span></div></div><div class="grid gap-5"><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-5 w-5" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><div><h3 class="text-body font-semibold text-white">One mistake and it all reverts</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">A single leftover entry makes the final merge fail. Every offer, position, asset and entry must clear in the right order first.</p></div></div><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-5 w-5" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><div><h3 class="text-body font-semibold text-white">Exchanges can&#x27;t merge</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">No major exchange accepts an account merge as a deposit. Pay your XLM out to an exchange instead and the 1 XLM minimum stays locked in the account.</p></div></div><div class="mkt-reveal  mkt-card flex gap-4 p-5" style="transition-delay:0ms"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><div><h3 class="text-body font-semibold text-white">DeFi positions hide outside the account</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">A Blend loan, Aquarius liquidity or a Soroswap position lives in the protocol&#x27;s contract. Merge the account while one is open and the funds stay stranded there, so each has to be exited through its own contract first.</p></div></div></div></div></section><section class="mx-auto max-w-6xl border-t border-white/[0.07] px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>What you get</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Built for the messy reality of real accounts.</h2></div><div class="mt-11 grid gap-4 lg:grid-cols-3"><div class="mkt-reveal  lg:col-span-2" style="transition-delay:0ms"><div class="mkt-card h-full p-6 [border-color:hsl(var(--accent)/0.25)]"><div class="flex items-start justify-between gap-4"><span class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><span class="rounded-full border border-accent/40 px-2.5 py-1 mkt-mono text-caption uppercase tracking-wider text-accent">Live</span></div><h3 class="mt-4 text-lg font-semibold text-white">Soroban DeFi exits</h3><p class="mt-2 max-w-md text-sm leading-relaxed text-white/70">Detects positions through OctoPos and exits each one with its own protocol adapter, repaying loans, withdrawing liquidity and unstaking, before the trustline is removed.</p><ul aria-label="Protocol exits live on mainnet" class="mt-5 flex flex-wrap gap-2" data-site-status="live"><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Blend</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Soroswap</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Aquarius</li><li class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-1 mkt-mono text-xs text-white/70">Phoenix</li></ul><p class="mt-3 text-sm text-fg-muted" data-site-status="testnet-only">Testnet only<!-- -->: <!-- -->FxDAO</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-5 w-5" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Live</span></div><h3 class="mt-4 text-body font-semibold text-white">Allowance inspector</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">See every token approval your account granted to DeFi contracts, and revoke risky ones, even without closing.</p><a class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-accent underline-offset-4 hover:underline" href="/mainnet/allowances">Open the allowance inspector<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-fg-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-5 w-5" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-line-strong text-fg-muted">Testnet only</span></div><h3 class="mt-4 text-body font-semibold text-white">Exchange-compatible close</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">A shared relay account receives the merge and pays the balance on to an exchange deposit address, with the memo the exchange requires, in the same transaction.</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-5 w-5" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Live</span></div><h3 class="mt-4 text-body font-semibold text-white">Resumable sessions</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">Close the tab mid-flow and resume in the same browser: the account is re-read and a fresh plan covers only what is left, so confirmed work is not repeated.</p></div></div><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card flex h-full flex-col p-5"><div class="flex items-center justify-between"><span class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line h-5 w-5" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><span class="mkt-mono rounded-full border px-2.5 py-1 text-caption uppercase tracking-wider border-accent/40 text-accent">Live</span></div><h3 class="mt-4 text-body font-semibold text-white">Deterministic, auditable plan</h3><p class="mt-1.5 text-sm leading-relaxed text-white/70">The same account state always produces the same ordered plan: testable, reviewable, never built on stale data.</p></div></div></div></section><section id="faq" class="mx-auto max-w-3xl scroll-mt-20 border-t border-white/[0.07] px-5 py-20 lg:px-8 lg:py-24"><div class="mkt-reveal  text-center" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>FAQ</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display">Questions, answered.</h2><p class="mt-4 text-white/70">Closing an account is irreversible. Here&#x27;s exactly how LumenWipe keeps it safe.</p></div><div class="mt-10"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_m_-0-header" aria-controls="_R_m_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">Is LumenWipe really non-custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-0-panel" role="region" aria-labelledby="_R_m_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. <!-- -->Your secret key never reaches a LumenWipe server, and LumenWipe does not store or log it: you sign in your browser, through your wallet or a key held in memory for this session only.<!-- --> <!-- -->The LumenWipe API reads your account and builds each unsigned transaction. Before you sign, your browser decodes it and checks its operations and destination against what you entered; if they do not match, it stops before asking you to sign.<!-- --> <!-- -->Two keys sign on the server, and neither can sign for your account.<!-- --> <span>Relay account key<!-- -->: <!-- -->In an exchange close, it co-signs only a two-operation transaction: your account&#x27;s merge into the relay account and an XLM payment from it in the same transaction. Before you sign, your browser checks that this payment goes to the exchange address you typed.<!-- --> <!-- -->Testnet only today.<!-- --> </span><span>Fee-sponsor key<!-- -->: <!-- -->When a fee is sponsored, it signs only the fee-bump envelope that pays the network fee for a transaction you already signed, and cannot change that transaction.<!-- --> <!-- -->Testnet only today.<!-- --> </span>The check is open source:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (opens in a new tab)</span></a>.</p></div></div></div><div><button type="button" id="_R_m_-1-header" aria-controls="_R_m_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Is closing an account reversible?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-1-panel" role="region" aria-labelledby="_R_m_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. The final merge permanently removes the account from the Stellar ledger. Because the action is irreversible, LumenWipe shows the complete plan up front, simulates each step, and asks for explicit confirmation (with the raw transaction available to review) before every signature.</p></div></div></div><div><button type="button" id="_R_m_-2-header" aria-controls="_R_m_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">How much XLM will I actually get back?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-2-panel" role="region" aria-labelledby="_R_m_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Everything recoverable. Stellar requires a <span class="text-value">1 XLM</span> minimum balance (two base reserves) plus <span class="text-value">0.5 XLM</span> for each subentry: every trustline, open offer, data entry, and extra signer. LumenWipe unwinds all of them to release those reserves, converts leftover tokens to XLM, and sweeps the full balance to your destination.</p></div></div></div><div><button type="button" id="_R_m_-3-header" aria-controls="_R_m_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Can I send the recovered XLM straight to an exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-3-panel" role="region" aria-labelledby="_R_m_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">On testnet today.<!-- --> Exchanges don&#x27;t accept an account merge as a deposit, so LumenWipe routes the final merge through a relay account: a shared account that receives the merge and, in the same transaction, pays the balance out to your deposit address with the correct memo. Known exchanges are validated against a registry that enforces the required memo type, so deposits don&#x27;t go missing.<!-- --> On mainnet, the plan blocks an exchange close until the relay account is deployed there, so close to a wallet you control instead.</p></div></div></div><div><button type="button" id="_R_m_-4-header" aria-controls="_R_m_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Does it handle Soroban DeFi positions?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-4-panel" role="region" aria-labelledby="_R_m_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. LumenWipe detects positions through OctoPos and exits them in<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius and Phoenix</span> on mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only"><span class="text-white/80">FxDAO</span> exits run on testnet only</span>. Classic order-book offers are cancelled as part of every close, and classic AMM pool shares are withdrawn in full before it.</p></div></div></div><div><button type="button" id="_R_m_-5-header" aria-controls="_R_m_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Which wallets are supported?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-5-panel" role="region" aria-labelledby="_R_m_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Any wallet that Stellar Wallets Kit connects: Varial (formerly Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect and more. Power users can also use an advanced secret-key mode where the key is held in memory only for the duration of the close, never persisted and never sent to a server, and cleared when you finish, abort, navigate away, or click &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_m_-6-header" aria-controls="_R_m_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">What if I close the tab in the middle?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-6-panel" role="region" aria-labelledby="_R_m_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Anything already confirmed on the network stays done. Once you confirm the plan, this browser keeps a small record of the close: the account, the destination, the memo and the hash of any transaction still waiting, never your keys. When you come back in the same browser, the home page offers to resume: LumenWipe re-reads the account and builds a fresh plan for what is left, which you review and sign again, so confirmed work is not repeated. If a transaction was still waiting for the network, you check its outcome first. Your per-asset choices are kept only in this tab, so a reload shows them again for you to check; in another tab, or once this one is closed, you make them again.</p></div></div></div><div><button type="button" id="_R_m_-7-header" aria-controls="_R_m_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Mainnet or testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-7-panel" role="region" aria-labelledby="_R_m_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Both. Run the entire flow on testnet with no real funds at risk to see exactly what will happen, then switch to mainnet for the real close.<!-- --> <span data-site-status="testnet-only">Exchange closes, sponsored fees and FxDAO exits run on testnet only today.</span> Closing an account on mainnet is irreversible and entirely at your own risk: review each step, the simulation result, and the destination address before you sign anything.</p></div></div></div></div></div><p class="mt-6 text-center text-sm text-fg-muted">Still curious?<!-- --> <a href="https://docs.lumenwipe.com" target="_blank" rel="noopener noreferrer" class="text-accent underline-offset-4 hover:underline">Read the full documentation</a>.</p></section><section class="mx-auto max-w-6xl px-5 pb-24 lg:px-8"><div class="mkt-reveal  " style="transition-delay:0ms"><div class="mkt-card px-6 py-14 text-center sm:px-12 sm:py-20"><h2 class="mkt-display mx-auto max-w-2xl text-3xl font-bold leading-[1.05] text-white sm:text-5xl">Reclaim the XLM that&#x27;s been sitting locked.</h2><p class="mx-auto mt-5 max-w-lg text-body text-white/70">Try the entire flow on testnet with no funds at risk, then switch to mainnet for the real close.</p><div class="mt-8 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm" href="/testnet">Try on testnet</a></div><div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mkt-mono text-caption text-fg-muted"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> No signup</span><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Signed in your browser</span><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Open source</span></div></div></div></section>"`;

exports[`English marketing copy faq renders the recorded markup 1`] = `"<section class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-24"><script type="application/ld+json">{"@context":"https:\\u002f\\u002fschema.org","@graph":[{"@type":"FAQPage","url":"https:\\u002f\\u002fwww.lumenwipe.com\\u002ffaq","inLanguage":"en","mainEntity":[{"@type":"Question","name":"Is LumenWipe really non-custodial?","acceptedAnswer":{"@type":"Answer","text":"Yes. Your secret key never reaches a LumenWipe server, and LumenWipe does not store or log it: you sign in your browser, through your wallet or a key held in memory for this session only. The LumenWipe API reads your account and builds each unsigned transaction. Before you sign, your browser decodes it and checks its operations and destination against what you entered; if they do not match, it stops before asking you to sign. Two keys sign on the server, and neither can sign for your account. Relay account key: In an exchange close, it co-signs only a two-operation transaction: your account's merge into the relay account and an XLM payment from it in the same transaction. Before you sign, your browser checks that this payment goes to the exchange address you typed. Testnet only today. Fee-sponsor key: When a fee is sponsored, it signs only the fee-bump envelope that pays the network fee for a transaction you already signed, and cannot change that transaction. Testnet only today. The check is open source: verify.ts."}},{"@type":"Question","name":"Is closing an account reversible?","acceptedAnswer":{"@type":"Answer","text":"No. The final merge permanently removes the account from the Stellar ledger. Because the action is irreversible, LumenWipe shows the complete plan up front, simulates each step, and asks for explicit confirmation (with the raw transaction available to review) before every signature."}},{"@type":"Question","name":"How much XLM will I actually get back?","acceptedAnswer":{"@type":"Answer","text":"Everything recoverable. Stellar requires a 1 XLM minimum balance (two base reserves) plus 0.5 XLM for each subentry: every trustline, open offer, data entry, and extra signer. LumenWipe unwinds all of them to release those reserves, converts leftover tokens to XLM, and sweeps the full balance to your destination."}},{"@type":"Question","name":"Can I send the recovered XLM straight to an exchange?","acceptedAnswer":{"@type":"Answer","text":"On testnet today. Exchanges don't accept an account merge as a deposit, so LumenWipe routes the final merge through a relay account: a shared account that receives the merge and, in the same transaction, pays the balance out to your deposit address with the correct memo. Known exchanges are validated against a registry that enforces the required memo type, so deposits don't go missing. On mainnet, the plan blocks an exchange close until the relay account is deployed there, so close to a wallet you control instead."}},{"@type":"Question","name":"Does it handle Soroban DeFi positions?","acceptedAnswer":{"@type":"Answer","text":"Yes. LumenWipe detects positions through OctoPos and exits them in Blend, Soroswap, Aquarius and Phoenix on mainnet; FxDAO exits run on testnet only. Classic order-book offers are cancelled as part of every close, and classic AMM pool shares are withdrawn in full before it."}},{"@type":"Question","name":"Which wallets are supported?","acceptedAnswer":{"@type":"Answer","text":"Any wallet that Stellar Wallets Kit connects: Varial (formerly Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect and more. Power users can also use an advanced secret-key mode where the key is held in memory only for the duration of the close, never persisted and never sent to a server, and cleared when you finish, abort, navigate away, or click \\"Forget key\\"."}},{"@type":"Question","name":"What if I close the tab in the middle?","acceptedAnswer":{"@type":"Answer","text":"Anything already confirmed on the network stays done. Once you confirm the plan, this browser keeps a small record of the close: the account, the destination, the memo and the hash of any transaction still waiting, never your keys. When you come back in the same browser, the home page offers to resume: LumenWipe re-reads the account and builds a fresh plan for what is left, which you review and sign again, so confirmed work is not repeated. If a transaction was still waiting for the network, you check its outcome first. Your per-asset choices are kept only in this tab, so a reload shows them again for you to check; in another tab, or once this one is closed, you make them again."}},{"@type":"Question","name":"Mainnet or testnet?","acceptedAnswer":{"@type":"Answer","text":"Both. Run the entire flow on testnet with no real funds at risk to see exactly what will happen, then switch to mainnet for the real close. Exchange closes, sponsored fees and FxDAO exits run on testnet only today. Closing an account on mainnet is irreversible and entirely at your own risk: review each step, the simulation result, and the destination address before you sign anything."}}]}]}</script><div class="text-center"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>FAQ</span><h1 class="mkt-display mt-4 text-4xl font-bold text-white sm:text-5xl">Questions, answered.</h1><p class="mx-auto mt-4 max-w-xl text-white/70">Closing an account is irreversible. Here&#x27;s exactly how LumenWipe keeps it safe.</p></div><div class="mt-12"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_3_-0-header" aria-controls="_R_3_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">Is LumenWipe really non-custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-0-panel" role="region" aria-labelledby="_R_3_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. <!-- -->Your secret key never reaches a LumenWipe server, and LumenWipe does not store or log it: you sign in your browser, through your wallet or a key held in memory for this session only.<!-- --> <!-- -->The LumenWipe API reads your account and builds each unsigned transaction. Before you sign, your browser decodes it and checks its operations and destination against what you entered; if they do not match, it stops before asking you to sign.<!-- --> <!-- -->Two keys sign on the server, and neither can sign for your account.<!-- --> <span>Relay account key<!-- -->: <!-- -->In an exchange close, it co-signs only a two-operation transaction: your account&#x27;s merge into the relay account and an XLM payment from it in the same transaction. Before you sign, your browser checks that this payment goes to the exchange address you typed.<!-- --> <!-- -->Testnet only today.<!-- --> </span><span>Fee-sponsor key<!-- -->: <!-- -->When a fee is sponsored, it signs only the fee-bump envelope that pays the network fee for a transaction you already signed, and cannot change that transaction.<!-- --> <!-- -->Testnet only today.<!-- --> </span>The check is open source:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (opens in a new tab)</span></a>.</p></div></div></div><div><button type="button" id="_R_3_-1-header" aria-controls="_R_3_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Is closing an account reversible?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-1-panel" role="region" aria-labelledby="_R_3_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. The final merge permanently removes the account from the Stellar ledger. Because the action is irreversible, LumenWipe shows the complete plan up front, simulates each step, and asks for explicit confirmation (with the raw transaction available to review) before every signature.</p></div></div></div><div><button type="button" id="_R_3_-2-header" aria-controls="_R_3_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">How much XLM will I actually get back?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-2-panel" role="region" aria-labelledby="_R_3_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Everything recoverable. Stellar requires a <span class="text-value">1 XLM</span> minimum balance (two base reserves) plus <span class="text-value">0.5 XLM</span> for each subentry: every trustline, open offer, data entry, and extra signer. LumenWipe unwinds all of them to release those reserves, converts leftover tokens to XLM, and sweeps the full balance to your destination.</p></div></div></div><div><button type="button" id="_R_3_-3-header" aria-controls="_R_3_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Can I send the recovered XLM straight to an exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-3-panel" role="region" aria-labelledby="_R_3_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">On testnet today.<!-- --> Exchanges don&#x27;t accept an account merge as a deposit, so LumenWipe routes the final merge through a relay account: a shared account that receives the merge and, in the same transaction, pays the balance out to your deposit address with the correct memo. Known exchanges are validated against a registry that enforces the required memo type, so deposits don&#x27;t go missing.<!-- --> On mainnet, the plan blocks an exchange close until the relay account is deployed there, so close to a wallet you control instead.</p></div></div></div><div><button type="button" id="_R_3_-4-header" aria-controls="_R_3_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Does it handle Soroban DeFi positions?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-4-panel" role="region" aria-labelledby="_R_3_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. LumenWipe detects positions through OctoPos and exits them in<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius and Phoenix</span> on mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only"><span class="text-white/80">FxDAO</span> exits run on testnet only</span>. Classic order-book offers are cancelled as part of every close, and classic AMM pool shares are withdrawn in full before it.</p></div></div></div><div><button type="button" id="_R_3_-5-header" aria-controls="_R_3_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Which wallets are supported?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-5-panel" role="region" aria-labelledby="_R_3_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Any wallet that Stellar Wallets Kit connects: Varial (formerly Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect and more. Power users can also use an advanced secret-key mode where the key is held in memory only for the duration of the close, never persisted and never sent to a server, and cleared when you finish, abort, navigate away, or click &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_3_-6-header" aria-controls="_R_3_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">What if I close the tab in the middle?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-6-panel" role="region" aria-labelledby="_R_3_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Anything already confirmed on the network stays done. Once you confirm the plan, this browser keeps a small record of the close: the account, the destination, the memo and the hash of any transaction still waiting, never your keys. When you come back in the same browser, the home page offers to resume: LumenWipe re-reads the account and builds a fresh plan for what is left, which you review and sign again, so confirmed work is not repeated. If a transaction was still waiting for the network, you check its outcome first. Your per-asset choices are kept only in this tab, so a reload shows them again for you to check; in another tab, or once this one is closed, you make them again.</p></div></div></div><div><button type="button" id="_R_3_-7-header" aria-controls="_R_3_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Mainnet or testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_3_-7-panel" role="region" aria-labelledby="_R_3_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Both. Run the entire flow on testnet with no real funds at risk to see exactly what will happen, then switch to mainnet for the real close.<!-- --> <span data-site-status="testnet-only">Exchange closes, sponsored fees and FxDAO exits run on testnet only today.</span> Closing an account on mainnet is irreversible and entirely at your own risk: review each step, the simulation result, and the destination address before you sign anything.</p></div></div></div></div></div><div class="mt-10 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://docs.lumenwipe.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm">Read the documentation</a></div></section>"`;

exports[`English marketing copy security renders the recorded markup 1`] = `"<section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24"><div class="max-w-2xl"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-5 bg-line-strong"></span>Trust model</span><h1 class="mkt-display mt-4 text-4xl font-bold text-white sm:text-5xl">The trust boundary is your browser.</h1><p class="mt-5 text-body leading-relaxed text-white/70">LumenWipe builds transactions that drain accounts irreversibly, so the design starts from that fact. <!-- -->Your secret key never reaches a LumenWipe server, and LumenWipe does not store or log it: you sign in your browser, through your wallet or a key held in memory for this session only.<!-- --> <!-- -->The LumenWipe API reads your account and builds each unsigned transaction. Before you sign, your browser decodes it and checks its operations and destination against what you entered; if they do not match, it stops before asking you to sign.</p><p class="mt-4 text-body leading-relaxed text-white/70">The check is open source:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">read verify.ts on GitHub<span class="sr-only"> (opens in a new tab)</span></a>. The exchanges and memo rules it checks against, and the protocols it can exit, are listed in the<!-- --> <a class="text-accent underline underline-offset-4" href="/registry">exchange registry</a>.</p></div><div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16"><div class="space-y-2.5"><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-accent/40 bg-accent/[0.06]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">Your browser</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Wallet · transaction check · signing · session</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-white">your key stays here</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">LumenWipe API</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Account reads · DeFi adapters · builds unsigned transactions · relay and fee-sponsor keys</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-fg-subtle">never holds your key</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0 flex-1"><div class="text-sm font-semibold text-white">Stellar network &amp; data</div><div class="mkt-mono break-words text-caption leading-snug text-fg-subtle">Stellar RPC · Horizon · Soroswap API</div></div><span class="mkt-mono shrink-0 whitespace-nowrap text-caption uppercase tracking-wider text-fg-subtle">read · simulate · submit</span></div><p class="mkt-mono flex items-center gap-2 pt-2 text-caption text-fg-subtle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Your key stays in your browser</p></div><ul class="overflow-hidden rounded-2xl border border-white/10"><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round h-4 w-4" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><div><div class="text-sm font-semibold text-white">Private key</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Never transmitted. It stays in your wallet, or in memory only for the duration of the close, never persisted and cleared when you finish, abort, or navigate away.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/signer.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signer.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/hooks/useActiveSigner.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">useActiveSigner.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/execution-wizard.test.tsx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">execution-wizard.test.tsx<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/signer.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signer.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line h-4 w-4" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><div><div class="text-sm font-semibold text-white">Every destructive step</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Explicitly confirmed before signing. The full plan is shown up front, a destructive choice counts only for the exact destination or account you acknowledged, and your browser checks each transaction before your wallet asks you to approve it.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/api/close-decisions.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">close-decisions.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/hooks/useCloseExecution.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">useCloseExecution.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/close-decisions.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">close-decisions.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/signing-guards.test.tsx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">signing-guards.test.tsx<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-4 w-4" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></span><div><div class="text-sm font-semibold text-white">Exchange memo</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Required and validated against a registry of known exchanges that enforces the memo type; a missing memo blocks submission so deposits don&#x27;t go missing.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/exchange-registry/index.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">index.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/plan/memo-requirement.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">memo-requirement.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/memo-requirement.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">memo-requirement.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/exchange-registry.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">exchange-registry.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server h-4 w-4" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></span><div><div class="text-sm font-semibold text-white">API compromise</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">It holds no key that can sign for your account, and your browser checks the operations and destination of every transaction it builds before you sign. Figures your browser can only take from the API&#x27;s own reads, such as a conversion quote, are shown for you to accept.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/mediator/mediator-signing.service.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediator-signing.service.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify-conformance.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify-conformance.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/mediator-validation.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediator-validation.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></div></li><li class="flex gap-3.5 border-t border-white/[0.06] bg-white/[0.02] p-4 first:border-t-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-network h-4 w-4" aria-hidden="true"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path></svg></span><div><div class="text-sm font-semibold text-white">Strict CSP</div><div class="mt-0.5 text-sm leading-relaxed text-fg-muted">Scripts get no unsafe-inline and no unsafe-eval: an inline script in the page runs only when the policy names it, by its hash on prerendered pages and by a per-request nonce elsewhere. Dependencies are lockfile-pinned and checked for known vulnerabilities in CI, and the web app contains no code that builds a transaction: a lint rule refuses it.</div><dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/proxy.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">proxy.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/config/marketing-csp.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.mjs<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/scripts/marketing-csp.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.mjs<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/scripts/audit-gate.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">audit-gate.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/eslint.config.mjs" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">eslint.config.mjs<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/proxy.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">proxy.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/marketing-csp.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">marketing-csp.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/scripts/audit-gate.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">audit-gate.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/boundary-lint.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">boundary-lint.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></div></li></ul></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Keys on the server</h2><p class="mt-3 text-body leading-relaxed text-white/70">Two keys sign on the server, and neither can sign for your account.</p><dl class="mt-5 space-y-4"><div class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Relay account key</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">In an exchange close, it co-signs only a two-operation transaction: your account&#x27;s merge into the relay account and an XLM payment from it in the same transaction. Before you sign, your browser checks that this payment goes to the exchange address you typed.<!-- --> <!-- -->Testnet only today.</dd></div><div class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Fee-sponsor key</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">When a fee is sponsored, it signs only the fee-bump envelope that pays the network fee for a transaction you already signed, and cannot change that transaction.<!-- --> <!-- -->Testnet only today.</dd></div></dl></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">What a close costs</h2><p class="mt-3 text-body leading-relaxed text-white/70">LumenWipe charges nothing for a close. Its fees go to the Stellar network, and a token conversion you choose pays the aggregator&#x27;s fee inside its quote. Each row names the code that sets or refuses the charge.</p><dl class="mt-5 space-y-4"><div data-fee="network" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Network fee</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">The Stellar base fee, 100 stroops (0.00001 XLM) per operation, paid to the network. A DeFi exit pays the fee its simulation reports instead, and your browser refuses one above a fixed cap.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/config/constants.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">constants.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/close-api/plan-fee.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">plan-fee.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/plan-fee.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">plan-fee.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></dd></div><div data-fee="service" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Service fee</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">None. Your browser refuses a transaction carrying any operation it cannot describe, so no charge can be added to a close.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></dd></div><div data-fee="sponsored" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Sponsored fees</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">When the fee sponsor is configured, it pays the network fee of each close transaction its rule accepts, through a fee bump; that transaction carries no fee of its own. Testnet only today.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/fee-bump/fee-bump.controller.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">fee-bump.controller.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/fee-bump-controller.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">fee-bump-controller.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></dd></div><div data-fee="relay" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Relay account (exchange closes)</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Your account is merged into a shared relay account that, in the same transaction, forwards the balance to the exchange with your memo. The forward is the balance less that transaction&#x27;s network fee, 200 stroops for its two operations, and your browser refuses a forward short of the balance it read by more than a small tolerance. Testnet only today.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/stellar/tx-builder/merge.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">merge.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/tests/unit/mediatorMerge.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">mediatorMerge.test.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></dd></div><div data-fee="conversion" class="rounded-xl border border-white/10 bg-white/[0.02] p-4"><dt class="text-sm font-semibold text-white">Token conversion</dt><dd class="mt-1 text-sm leading-relaxed text-fg-muted">Optional. A token you choose to convert is swapped through the Soroswap aggregator, whose own fee is part of the quote you accept. A swap that names a fee partner is refused by the API and by your browser.<dl data-evidence="true" class="mt-2 space-y-1 text-caption leading-snug text-fg-subtle"><div class="flex flex-wrap items-center gap-x-2"><dt>Enforced in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/api/src/lib/close-api/token-conversion-round.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">token-conversion-round.ts<span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div><div class="flex flex-wrap items-center gap-x-2"><dt>Tested in</dt><dd class="mkt-mono flex flex-wrap gap-x-2"><a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/tests/unit/verify.test.ts" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center break-all text-fg-muted underline underline-offset-2 hover:text-white">verify.test.ts<span class="sr-only"> (opens in a new tab)</span></a></dd></div></dl></dd></div></dl></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">How to verify the build you are running</h2><p class="mt-3 text-body leading-relaxed text-white/70">This build carries no commit hash: only a deployment built from the repository sets one.</p><p class="mt-3 text-body leading-relaxed text-white/70">The web app deploys continuously from main and has no release tag, so the commit is its version.</p></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Report a vulnerability</h2><p class="mt-3 text-body leading-relaxed text-white/70">Email<!-- --> <a href="mailto:security@lumenwipe.com" class="text-accent underline underline-offset-4">security@lumenwipe.com</a>, and do not open a public issue. The scope, response times and disclosure process are in<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">SECURITY.md<span class="sr-only"> (opens in a new tab)</span></a>; the same contact is published in<!-- --> <a href="/.well-known/security.txt" class="mkt-mono text-accent underline underline-offset-4">/.well-known/security.txt</a>.</p></div><div class="mt-12 max-w-3xl"><h2 class="mkt-display text-2xl font-bold text-white">Security reports</h2><p class="mt-3 text-body leading-relaxed text-white/70">What has been reviewed, by whom, and what it found: the reports page lists every published security report and, until one exists, the self-assessed documents there are today.</p><p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-body"><a class="text-accent underline underline-offset-4" href="/security/reports">See the security reports</a></p></div><div class="mt-12 flex flex-wrap items-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://docs.lumenwipe.com/architecture" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm">Read the security model</a></div></section>"`;

exports[`English marketing copy how it works renders the recorded markup 1`] = `"<section class="mx-auto max-w-4xl px-5 pb-14 pt-16 text-center lg:px-8 lg:pt-24"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>How it works</span><h1 class="mkt-display mx-auto mt-5 max-w-3xl text-display font-extrabold leading-[1.02] text-white sm:text-6xl">A deterministic plan for an irreversible action.</h1><p class="mx-auto mt-6 max-w-2xl text-body leading-relaxed text-white/85">Closing an account takes one or more transactions in the right order. LumenWipe shows the whole plan up front, then executes it one transaction at a time, each confirmed before the next, re-reading live state and simulating before every signature, so nothing is ever signed on stale data.</p><div class="mt-8 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 border border-line-strong text-fg not-disabled:hover:bg-surface-raised not-disabled:active:bg-surface min-h-12 px-5 text-sm" href="/faq">Jump to FAQ</a></div></div></section><section class="border-y border-white/8 bg-white/[0.012]"><div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-20"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>The execution loop</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-4xl">Every step runs the same safe loop.</h2><p class="mt-4 leading-relaxed text-white/85">No step trusts a cached value. Each one reconciles against the live ledger, simulates, and waits for your explicit approval before a single byte is signed.</p></div><div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"><div class="mkt-reveal  " style="transition-delay:0ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw h-4 w-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Re-read live state</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">getLedgerEntries</p></div></div><div class="mkt-reveal  " style="transition-delay:60ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Simulate</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">simulateTransaction</p></div></div><div class="mkt-reveal  " style="transition-delay:120ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Confirm</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">you approve</p></div></div><div class="mkt-reveal  " style="transition-delay:180ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool h-4 w-4" aria-hidden="true"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Sign in browser</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">your wallet</p></div></div><div class="mkt-reveal  " style="transition-delay:240ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4 w-4" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Submit XDR</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">to Stellar RPC</p></div></div><div class="mkt-reveal  " style="transition-delay:300ms"><div class="relative flex h-full flex-col items-start rounded-xl border border-white/10 bg-surface/70 p-4"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-white">Poll &amp; advance</h3><p class="mt-0.5 mkt-mono text-caption text-fg-muted">next step</p></div></div></div><p class="mt-5 inline-flex items-center gap-2 mkt-mono text-xs text-fg-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="m17 2 4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path d="m7 22-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg>repeats for every step in the plan</p></div></section><section class="mx-auto max-w-4xl px-5 py-20 lg:px-8 lg:py-28"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>The plan</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">Eight ordered steps, every reserve accounted for.</h2></div><ol class="mt-12 space-y-3"><li class="mkt-reveal  " style="transition-delay:0ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search h-5 w-5" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">01</span><h3 class="text-base font-semibold text-white">Analyze the account</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Enumerate every subentry (trustlines, offers, data entries, signers) and detect DeFi positions through OctoPos. The result is a single, ordered execution plan.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>Horizon + Stellar RPC</div></div></div></li><li class="mkt-reveal  " style="transition-delay:40ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round h-5 w-5" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">02</span><h3 class="text-base font-semibold text-white">Normalize signers</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Remove extra signers and reset thresholds so a single key can authorize every remaining step without surprises mid-flow.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>SetOptions</div></div></div></li><li class="mkt-reveal  " style="transition-delay:80ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database h-5 w-5" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">03</span><h3 class="text-base font-semibold text-white">Remove data entries</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Clear every ManageData entry in batches, releasing 0.5 XLM of reserve each.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ManageData (value = null)</div></div></div></li><li class="mkt-reveal  " style="transition-delay:120ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x lucide-x-circle h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">04</span><h3 class="text-base font-semibold text-white">Cancel DEX offers</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Close all open order-book offers, freeing the reserve each one holds.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ManageSellOffer / ManageBuyOffer · amount = 0</div></div></div></li><li class="mkt-reveal  " style="transition-delay:160ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 h-5 w-5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">05</span><h3 class="text-base font-semibold text-white">Exit DeFi positions</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Exit every supported Soroban protocol position, repaying loans and unstaking first where needed, via each protocol&#x27;s own adapter. Classic AMM pool shares are withdrawn in full.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>InvokeHostFunction · Blend · Soroswap · Aquarius · Phoenix</div></div></div></li><li class="mkt-reveal  " style="transition-delay:200ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right h-5 w-5" aria-hidden="true"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">06</span><h3 class="text-base font-semibold text-white">Convert assets to XLM</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Swap every remaining token to XLM along the best available route across Soroban and classic venues.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>Soroswap API · SDEX path payments</div></div></div></li><li class="mkt-reveal  " style="transition-delay:240ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-unlink h-5 w-5" aria-hidden="true"><path d="m18.84 12.25 1.72-1.71h-.02a5.004 5.004 0 0 0-.12-7.07 5.006 5.006 0 0 0-6.95 0l-1.72 1.71"></path><path d="m5.17 11.75-1.71 1.71a5.004 5.004 0 0 0 .12 7.07 5.006 5.006 0 0 0 6.95 0l1.71-1.71"></path><line x1="8" x2="8" y1="2" y2="5"></line><line x1="2" x2="5" y1="8" y2="8"></line><line x1="16" x2="16" y1="19" y2="22"></line><line x1="19" x2="22" y1="16" y2="16"></line></svg></span><span class="mt-2 w-px flex-1 bg-gradient-to-b from-white/15 to-transparent"></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">07</span><h3 class="text-base font-semibold text-white">Remove trustlines</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Once a balance is zero, remove its trustline and release the 0.5 XLM reserve.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>ChangeTrust · limit = 0</div></div></div></li><li class="mkt-reveal  " style="transition-delay:280ms"><div class="group relative flex gap-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-accent/30 sm:p-6"><div class="flex flex-col items-center"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-merge h-5 w-5" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 9 9"></path></svg></span></div><div class="min-w-0 pb-1"><div class="flex items-center gap-3"><span class="mkt-mono text-xs text-fg-subtle">08</span><h3 class="text-base font-semibold text-white">Merge the account</h3></div><p class="mt-2 text-sm leading-relaxed text-white/85">Execute the final merge, directly to a wallet or through a relay account for an exchange destination. The base reserve comes back too.</p><div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-black/30 px-2.5 py-1 mkt-mono text-caption text-fg-muted"><span class="text-fg-muted">op</span>AccountMerge</div></div></div></li></ol></section><section class="border-y border-white/8 bg-white/[0.012]"><div class="mx-auto max-w-5xl px-5 py-20 lg:px-8 lg:py-28"><div class="mkt-reveal  max-w-2xl" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Exchange destinations</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-display sm:leading-[1.05]">The CEX relay flow.</h2><p class="mt-5 leading-relaxed text-white/85">Exchanges don&#x27;t support<!-- --> <span class="mkt-mono text-white/80">ACCOUNT_MERGE</span>. LumenWipe bridges the gap with one shared relay account: the merge sends your balance into it and, in the same transaction, it pays that balance on to your deposit address with the memo. Its key stays on the LumenWipe API, which co-signs only that payment, and your browser checks that the payment goes to the address you typed before you sign.</p></div><div class="mkt-reveal  " style="transition-delay:100ms"><div class="mkt-panel mt-10 rounded-2xl p-6 sm:p-8"><div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="flex-1 rounded-xl border p-4 text-center border-white/12 bg-white/[0.03]"><div class="text-sm font-semibold text-white">Source account</div><div class="mt-1 text-caption text-fg-muted">the account you&#x27;re closing</div></div><div class="flex flex-row items-center justify-center gap-2 text-fg-muted sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-4 w-4 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down h-4 w-4 sm:hidden" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg><span class="mkt-mono text-caption uppercase tracking-wider text-fg-muted">AccountMerge</span></div><div class="flex-1 rounded-xl border p-4 text-center border-accent/40 bg-accent/[0.06]"><div class="text-sm font-semibold text-white">Relay account</div><div class="mt-1 text-caption text-fg-muted">shared · co-signed by the API</div></div><div class="flex flex-row items-center justify-center gap-2 text-fg-muted sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-4 w-4 sm:block" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down h-4 w-4 sm:hidden" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg><span class="mkt-mono text-caption uppercase tracking-wider text-fg-muted">Payment + memo</span></div><div class="flex-1 rounded-xl border p-4 text-center border-white/12 bg-white/[0.03]"><div class="text-sm font-semibold text-white">Exchange deposit</div><div class="mt-1 text-caption text-fg-muted">validated address &amp; memo</div></div></div><p class="mt-6 text-center text-sm text-fg-muted">The relay account forwards your whole balance less a two-operation network fee, so none of your reserve stays behind, and the review names the exchange and the relay route before you sign. Known exchanges are validated against a registry that enforces the correct memo type.</p></div></div></div></section><section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-12 lg:grid-cols-2 lg:gap-16"><div class="mkt-reveal  " style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Resumable by design</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-3xl">Close the tab. Pick up where you left off.</h2><p class="mt-4 leading-relaxed text-white/85">The close moves through these phases in your browser. Once you confirm the plan, the browser keeps a small record of the close, never your keys. On return, LumenWipe re-reads the account and builds a fresh plan for what is left, which you review and sign again, so confirmed work is not repeated.</p><div class="mt-7 flex flex-wrap items-center gap-2"><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Idle</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Analyzing</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">PreflightComplete</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">StepExecuting</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">StepConfirmed</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 text-fg-disabled" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span><span class="inline-flex items-center gap-2"><span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 mkt-mono text-xs text-white/70">Complete</span></span></div></div><div class="mkt-reveal  " style="transition-delay:100ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>Architecture</span><h2 class="mkt-display mt-4 text-2xl font-bold text-white sm:text-3xl">Three layers, one trust boundary.</h2><p class="mt-4 leading-relaxed text-white/85">No bespoke indexer. Every read source sits behind an adapter, so any compatible provider can be swapped in without touching the rest of the system.</p><div class="mt-7 space-y-2.5"><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-accent/40 bg-accent/[0.06]"><div class="min-w-0"><div class="text-sm font-semibold text-white">Browser</div><div class="truncate mkt-mono text-caption text-fg-muted">UI · wallet · transaction check · signing · session</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-white">your key stays here</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0"><div class="text-sm font-semibold text-white">LumenWipe API</div><div class="truncate mkt-mono text-caption text-fg-muted">reads · DeFi adapters · routing · builds unsigned transactions</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-fg-muted">never holds your key</span></div><div class="flex items-center justify-between gap-3 rounded-xl border p-3.5 border-white/10 bg-white/[0.02]"><div class="min-w-0"><div class="text-sm font-semibold text-white">Stellar network</div><div class="truncate mkt-mono text-caption text-fg-muted">Stellar RPC · Horizon · Soroswap</div></div><span class="shrink-0 mkt-mono text-caption uppercase tracking-wider text-fg-muted">read · submit</span></div></div></div></div></section><section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-5 pb-24 lg:px-8"><div class="mkt-reveal  text-center" style="transition-delay:0ms"><span class="mkt-eyebrow inline-flex items-center gap-2 text-fg-muted"><span class="h-px w-6 bg-line-strong"></span>FAQ</span><h2 class="mkt-display mt-4 text-3xl font-bold text-white sm:text-4xl">Questions, answered.</h2></div><div class="mt-10"><div class="divide-y divide-white/8 overflow-hidden rounded-2xl border border-white/10 bg-surface/60"><div><button type="button" id="_R_m_-0-header" aria-controls="_R_m_-0-panel" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white">Is LumenWipe really non-custodial?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-0-panel" role="region" aria-labelledby="_R_m_-0-header" class="grid transition-all duration-300 ease-out grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. <!-- -->Your secret key never reaches a LumenWipe server, and LumenWipe does not store or log it: you sign in your browser, through your wallet or a key held in memory for this session only.<!-- --> <!-- -->The LumenWipe API reads your account and builds each unsigned transaction. Before you sign, your browser decodes it and checks its operations and destination against what you entered; if they do not match, it stops before asking you to sign.<!-- --> <!-- -->Two keys sign on the server, and neither can sign for your account.<!-- --> <span>Relay account key<!-- -->: <!-- -->In an exchange close, it co-signs only a two-operation transaction: your account&#x27;s merge into the relay account and an XLM payment from it in the same transaction. Before you sign, your browser checks that this payment goes to the exchange address you typed.<!-- --> <!-- -->Testnet only today.<!-- --> </span><span>Fee-sponsor key<!-- -->: <!-- -->When a fee is sponsored, it signs only the fee-bump envelope that pays the network fee for a transaction you already signed, and cannot change that transaction.<!-- --> <!-- -->Testnet only today.<!-- --> </span>The check is open source:<!-- --> <a href="https://github.com/LumenWipe/lumenwipe/blob/main/apps/web/lib/stellar/verify.ts" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">verify.ts<span class="sr-only"> (opens in a new tab)</span></a>.</p></div></div></div><div><button type="button" id="_R_m_-1-header" aria-controls="_R_m_-1-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Is closing an account reversible?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-1-panel" role="region" aria-labelledby="_R_m_-1-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">No. The final merge permanently removes the account from the Stellar ledger. Because the action is irreversible, LumenWipe shows the complete plan up front, simulates each step, and asks for explicit confirmation (with the raw transaction available to review) before every signature.</p></div></div></div><div><button type="button" id="_R_m_-2-header" aria-controls="_R_m_-2-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">How much XLM will I actually get back?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-2-panel" role="region" aria-labelledby="_R_m_-2-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Everything recoverable. Stellar requires a <span class="text-value">1 XLM</span> minimum balance (two base reserves) plus <span class="text-value">0.5 XLM</span> for each subentry: every trustline, open offer, data entry, and extra signer. LumenWipe unwinds all of them to release those reserves, converts leftover tokens to XLM, and sweeps the full balance to your destination.</p></div></div></div><div><button type="button" id="_R_m_-3-header" aria-controls="_R_m_-3-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Can I send the recovered XLM straight to an exchange?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-3-panel" role="region" aria-labelledby="_R_m_-3-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">On testnet today.<!-- --> Exchanges don&#x27;t accept an account merge as a deposit, so LumenWipe routes the final merge through a relay account: a shared account that receives the merge and, in the same transaction, pays the balance out to your deposit address with the correct memo. Known exchanges are validated against a registry that enforces the required memo type, so deposits don&#x27;t go missing.<!-- --> On mainnet, the plan blocks an exchange close until the relay account is deployed there, so close to a wallet you control instead.</p></div></div></div><div><button type="button" id="_R_m_-4-header" aria-controls="_R_m_-4-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Does it handle Soroban DeFi positions?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-4-panel" role="region" aria-labelledby="_R_m_-4-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Yes. LumenWipe detects positions through OctoPos and exits them in<!-- --> <span class="text-white/80">Blend, Soroswap, Aquarius and Phoenix</span> on mainnet<!-- -->;<!-- --> <span data-site-status="testnet-only"><span class="text-white/80">FxDAO</span> exits run on testnet only</span>. Classic order-book offers are cancelled as part of every close, and classic AMM pool shares are withdrawn in full before it.</p></div></div></div><div><button type="button" id="_R_m_-5-header" aria-controls="_R_m_-5-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Which wallets are supported?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-5-panel" role="region" aria-labelledby="_R_m_-5-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Any wallet that Stellar Wallets Kit connects: Varial (formerly Freighter), xBull, Albedo, LOBSTR, Hana, WalletConnect and more. Power users can also use an advanced secret-key mode where the key is held in memory only for the duration of the close, never persisted and never sent to a server, and cleared when you finish, abort, navigate away, or click &quot;Forget key&quot;.</p></div></div></div><div><button type="button" id="_R_m_-6-header" aria-controls="_R_m_-6-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">What if I close the tab in the middle?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-6-panel" role="region" aria-labelledby="_R_m_-6-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Anything already confirmed on the network stays done. Once you confirm the plan, this browser keeps a small record of the close: the account, the destination, the memo and the hash of any transaction still waiting, never your keys. When you come back in the same browser, the home page offers to resume: LumenWipe re-reads the account and builds a fresh plan for what is left, which you review and sign again, so confirmed work is not repeated. If a transaction was still waiting for the network, you check its outcome first. Your per-asset choices are kept only in this tab, so a reload shows them again for you to check; in another tab, or once this one is closed, you make them again.</p></div></div></div><div><button type="button" id="_R_m_-7-header" aria-controls="_R_m_-7-panel" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors hover:bg-white/[0.02] focus-visible:-outline-offset-2 sm:px-6 sm:py-5"><span class="text-body font-medium transition-colors text-white/80">Mainnet or testnet?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-accent transition-transform duration-300" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_m_-7-panel" role="region" aria-labelledby="_R_m_-7-header" inert="" class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0"><div class="overflow-hidden"><p class="px-5 pb-5 pr-10 text-sm leading-relaxed text-white/85 sm:px-6 sm:pb-6">Both. Run the entire flow on testnet with no real funds at risk to see exactly what will happen, then switch to mainnet for the real close.<!-- --> <span data-site-status="testnet-only">Exchange closes, sponsored fees and FxDAO exits run on testnet only today.</span> Closing an account on mainnet is irreversible and entirely at your own risk: review each step, the simulation result, and the destination address before you sign anything.</p></div></div></div></div></div><div class="mt-12 flex flex-col items-center gap-4 rounded-2xl border border-white/10 bg-surface p-8 text-center"><h3 class="mkt-display text-xl font-bold text-white">Ready when you are.</h3><a class="inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:opacity-40 bg-accent text-accent-fg not-disabled:hover:bg-accent/90 not-disabled:active:bg-accent/80 min-h-12 px-5 text-sm group" href="/mainnet">Open the app<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section>"`;

exports[`English marketing copy nav renders the recorded markup 1`] = `"<header class="sticky top-0 z-50 transition-colors duration-300 border-b border-transparent"><nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:px-8"><a aria-label="LumenWipe home" class="shrink-0" href="/"><span class="inline-flex items-center gap-2.5"><svg viewBox="0 0 32 32" fill="none" class="h-7 w-auto" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="8" stroke="hsl(var(--accent))" stroke-opacity="0.35" stroke-width="1.25"></rect><path d="M7 22c4.5 3 13.5 3 18 0" stroke="hsl(var(--value))" stroke-opacity="0.9" stroke-width="1.5" stroke-linecap="round"></path><path d="M16 6.5c.7 4.2 2.3 5.8 6.5 6.5-4.2.7-5.8 2.3-6.5 6.5-.7-4.2-2.3-5.8-6.5-6.5 4.2-.7 5.8-2.3 6.5-6.5Z" fill="hsl(var(--accent))"></path></svg><span class="mkt-display text-body font-bold tracking-tight text-white max-[359px]:sr-only">Lumen<span class="text-accent">Wipe</span></span></span></a><div class="hidden items-center gap-7 lg:flex"><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="/how-it-works">How it works<span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="/security">Security<span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><a class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="/content">Guides<span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><a target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center gap-0.5 py-1 text-sm transition-colors text-fg-muted hover:text-white" href="https://playground.lumenwipe.com">Playground<span class="sr-only"> (opens in a new tab)</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3 w-3 opacity-0 transition-opacity group-hover:opacity-60" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-full origin-left rounded-full bg-accent shadow-[0_0_8px_hsl(var(--accent)/0.7)] transition-transform duration-300 scale-x-0 group-hover:scale-x-50 group-hover:bg-white/40 group-hover:shadow-none"></span></a><div class="relative"><button type="button" aria-expanded="false" aria-controls="_R_2j_" class="inline-flex items-center gap-1 py-1 text-sm transition-colors text-fg-muted hover:text-white">Developers<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-3.5 w-3.5 transition-transform" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><ul id="_R_2j_" hidden="" class="absolute right-0 top-full mt-3 min-w-44 rounded-xl border border-white/10 bg-surface-raised p-1.5 shadow-lg"><li><a class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm text-white/85 transition-colors hover:bg-white/5