# Public app URL (used for sitemap, robots.txt, and structured data)
NEXT_PUBLIC_APP_URL=

# LumenWipe API (server-side only - the browser never sees these).
# The /api/** route handlers proxy to this backend via @lumenwipe/sdk.
# NOT NEXT_PUBLIC_*, so Next never inlines them into the browser bundle.
LUMENWIPE_API_URL=http://localhost:3001
LUMENWIPE_API_KEY=

# Pollar publishable key for the /api-keys page's social login (safe to expose to the browser).
# Create one in the Pollar dashboard and register this app's origin under Build > Domains.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Upstash Redis - required for the proxy rate limit
# Provision via: vercel link && vercel env pull
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exchange (mediator) closes need no web configuration. The mediator and fee-bump keys live in
# apps/api/.env.local; `bun scripts/setup-mediator.ts` prints values for it
# (set the public key there as MEDIATOR_PUBLIC_*).

# Stellar Wallets Kit - WalletConnect module. Public project ID (safe to expose
# to the client, 32 hex characters), generated at https://cloud.reown.com.
# Without it, the WalletConnect option (used to reach LOBSTR mobile) is
# unavailable and the wallet picker says so; the other wallet-kit options
# (Varial, xBull, Albedo, Rabet, Hana) still work. Required for a production
# deployment: the build fails when VERCEL_ENV=production and this is unset or
# not a project id (config/wallet-connect-build.mjs). Previews, CI and local
# builds do not need it.
NEXT_PUBLIC_STELLAR_WALLET_CONNECT_PROJECT_ID=

# Umami website ID for analytics (public, optional).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
