# Every variable the web app reads, and nothing else (`bun run check:env` checks both directions).
# NODE_ENV, VERCEL_ENV and CI are set by the platform and are not listed here.
# Operator scripts for the mediator live in apps/api (`bun run setup:mediator` there), and the
# mediator and fee-bump keys in apps/api/.env.local: exchange closes need no web configuration.

# ── Server-only: read by route handlers and server code, never inlined into the browser bundle ──

# LumenWipe API. The /api/** route handlers proxy to this backend via @lumenwipe/sdk.
LUMENWIPE_API_URL=http://localhost:3001
LUMENWIPE_API_KEY=

# Upstash Redis - the proxy rate limit. Required on Vercel production and preview deployments:
# without it there, the estimate and delivered-amount routes answer 503. Left empty locally or in
# CI, rate limiting is disabled (with a warning). Provision via: vercel link && vercel env pull
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The same credentials under the names the Vercel Upstash integration injects; read when the pair
# above is unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Browser: NEXT_PUBLIC_ values are inlined into the client bundle at build time, never a secret ──

# Public app URL (sitemap, robots.txt, structured data and the WalletConnect metadata).
NEXT_PUBLIC_APP_URL=

# Pollar publishable key for the /api-keys page's social login.
# Create one in the Pollar dashboard and register this app's origin under Build > Domains.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Stellar Wallets Kit - WalletConnect module. Public project ID (32 hex characters), generated at
# https://cloud.reown.com. Without it, the WalletConnect option (used to reach LOBSTR mobile) is
# unavailable and the wallet picker says so; the other wallet-kit options (Varial, xBull,
# Albedo, Rabet, Hana) still work. Required for a production deployment: the build fails when
# VERCEL_ENV=production and this is unset or not a project id (config/wallet-connect-build.mjs).
# Previews, CI and local builds do not need it.
NEXT_PUBLIC_STELLAR_WALLET_CONNECT_PROJECT_ID=

# Umami website ID for analytics (optional).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
