# Public app URL (used for sitemap, robots.txt, and structured data)
NEXT_PUBLIC_APP_URL=

# LumenWipe API (server-side only - the browser never sees these).
# The /api/** route handlers proxy to this backend via @lumenwipe/sdk.
# NOT NEXT_PUBLIC_*, so Next never inlines them into the browser bundle.
LUMENWIPE_API_URL=http://localhost:3001
LUMENWIPE_API_KEY=

# Stellar RPC endpoints
NEXT_PUBLIC_STELLAR_RPC_MAINNET=https://mainnet.stellar.validationcloud.io/v1/YOUR_KEY_HERE
NEXT_PUBLIC_STELLAR_RPC_TESTNET=https://soroban-testnet.stellar.org

# Optional: auth headers for RPC providers that require API key authentication
# (e.g. QuickNode uses X-QN-API-Key, DataHub uses Authorization: Bearer ...)
# NEXT_PUBLIC_STELLAR_RPC_HEADER_NAME_MAINNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_VALUE_MAINNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_NAME_TESTNET=
# NEXT_PUBLIC_STELLAR_RPC_HEADER_VALUE_TESTNET=

# Horizon-compatible endpoint for reads RPC cannot serve:
# open offers, account state with data entries/signers, and /paths/strict-send routing
NEXT_PUBLIC_PATH_ROUTING_API_MAINNET=
NEXT_PUBLIC_PATH_ROUTING_API_TESTNET=

# StellarExpert API base URLs (no key required)
# These are hardcoded in config/networks.ts - override here only for testing

# Vercel KV (Redis) - required for the merge counter
# Provision via: vercel link && vercel env pull
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared mediator account - required only for merges to exchanges that don't
# support ACCOUNT_MERGE. Generate a keypair, fund the account once (it keeps a
# ~1 XLM base reserve that is reused for everyone), put the PUBLIC key below
# (exposed to the client) and the SECRET on the server only (never prefixed
# with NEXT_PUBLIC_). Without these, exchange destinations cannot be processed.
MEDIATOR_SECRET_MAINNET=
MEDIATOR_SECRET_TESTNET=

# Stellar Wallets Kit - WalletConnect module. Public project ID (safe to expose
# to the client), generated at https://cloud.reown.com. Without it, the
# WalletConnect option (used to reach LOBSTR mobile) is unavailable; the other
# wallet-kit options (Freighter, xBull, Albedo, Rabet, Hana) still work.
NEXT_PUBLIC_STELLAR_WALLET_CONNECT_PROJECT_ID=

# Testnet playground (all server-only). Generate via: bun scripts/setup-playground.ts
PLAYGROUND_ISSUER_SECRET_TESTNET=
PLAYGROUND_MM_SECRET_TESTNET=
PLAYGROUND_ENCRYPTION_KEY=
