{
  "name": "lumenwipe-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@lumenwipe/web' dev",
    "dev:web": "bun run --filter '@lumenwipe/web' dev",
    "dev:api": "bun run --filter '@lumenwipe/api' dev",
    "dev:playground": "bun run --filter '@lumenwipe/playground' dev",
    "build": "bun run --filter '@lumenwipe/web' build",
    "build:web": "bun run --filter '@lumenwipe/web' build",
    "build:api": "bun run --filter '@lumenwipe/api' build",
    "build:playground": "bun run --filter '@lumenwipe/playground' build",
    "start": "bun run --filter '@lumenwipe/web' start",
    "start:web": "bun run --filter '@lumenwipe/web' start",
    "start:api": "bun run --filter '@lumenwipe/api' start:prod",
    "start:playground": "bun run --filter '@lumenwipe/playground' start",
    "lint": "bun run --filter '*' lint",
    "type-check": "bun run --filter '*' type-check",
    "test": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "bun scripts/check-docs-claims.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "@walletconnect/core": "2.23.7",
    "@walletconnect/sign-client": "2.23.7",
    "qs": "^6.16.0",
    "fast-uri": "^4.2.2",
    "smol-toml": "^1.9.0",
    "multer": "^2.4.0",
    "browserslist": "^4.28.8",
    "baseline-browser-mapping": "^2.11.20",
    "postcss-selector-parser": "^7.1.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "esbuild": "^0.28.2",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
