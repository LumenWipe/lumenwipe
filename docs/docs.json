{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LumenWipe",
  "colors": {
    "primary": "#00B0F0",
    "light": "#4DC4F5",
    "dark": "#00B0F0"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#080D0F",
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 700
    },
    "body": {
      "family": "Manrope"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://lumenwipe.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Documentation",
        "pages": [
          "index",
          "executive-summary",
          "architecture",
          "threat-model",
          "security-remediation-plan",
          "monitoring-plan",
          "community-and-communications"
        ]
      },
      {
        "group": "Use cases",
        "pages": [
          "use-cases/overview",
          "use-cases/individuals",
          "use-cases/wallets-and-exchanges",
          "use-cases/embedded-wallet-platforms",
          "use-cases/businesses-and-operations"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/closing-an-account",
          "guides/how-closing-works",
          "guides/signing-options",
          "guides/exiting-protocol-positions",
          "guides/exchanges-and-the-mediator",
          "guides/troubleshooting-and-faq"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/glossary",
          "reference/supported",
          "reference/logging-and-privacy",
          "changelog"
        ]
      },
      {
        "group": "SDK",
        "pages": [
          "sdk/overview",
          "sdk/client",
          "sdk/close-plan",
          "sdk/close-transactions",
          "sdk/submit",
          "sdk/run-close",
          "sdk/verification",
          "sdk/errors",
          "sdk/versioning",
          "sdk/headless-example"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/introduction",
          {
            "group": "Close",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /v1/{network}/close/plan",
              "POST /v1/{network}/close/batch-plan",
              "POST /v1/{network}/close/transactions",
              "POST /v1/{network}/submit"
            ]
          },
          {
            "group": "Account",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /{network}/account/{address}",
              "GET /{network}/allowances/{address}",
              "POST /{network}/allowances/revoke",
              "GET /{network}/paths"
            ]
          },
          {
            "group": "Mediator",
            "openapi": "api-reference/openapi.json",
            "pages": ["POST /{network}/mediator/sign", "GET /{network}/mediator/check/{address}"]
          },
          {
            "group": "Fee sponsorship",
            "openapi": "api-reference/openapi.json",
            "pages": ["POST /{network}/fee-bump/sponsor"]
          },
          {
            "group": "Config",
            "openapi": "api-reference/openapi.json",
            "pages": ["GET /config/exchange-registry"]
          },
          {
            "group": "Stats",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /v1/{network}/stats",
              "GET /v1/{network}/stats/feed",
              "POST /v1/{network}/stats/merges"
            ]
          },
          {
            "group": "Health",
            "openapi": "api-reference/openapi.json",
            "pages": ["GET /health", "GET /health/deep"]
          },
          {
            "group": "Service",
            "openapi": "api-reference/openapi.json",
            "pages": ["GET /"]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "chatgpt", "claude", "mcp"],
    "display": "header"
  },
  "navbar": {
    "links": [
      {
        "label": "Open the app",
        "href": "https://lumenwipe.com/mainnet",
        "icon": "arrow-up-right-from-square"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/LumenWipe/lumenwipe",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Executive summary",
      "href": "/executive-summary"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/LumenWipe/lumenwipe"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.lumenwipe.com"
    }
  }
}
