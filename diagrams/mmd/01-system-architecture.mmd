flowchart TB
    subgraph client["Browser client: trust boundary, verifies and signs"]
        direction TB
        ui["Guided UI<br/>(plan, confirmations, review)"]
        wk["Wallet adapter<br/>(stellar-wallets-kit)"]
        sk["Secret-key mode<br/>(in-memory only)"]
        verify["verify() - trust anchor<br/>(checks API-built XDR vs user intent)"]
        signer["Signer<br/>(signs only after verify passes)"]
        sess["Session store<br/>(IndexedDB, no keys)"]
    end

    proxy["Web proxy (Next.js, server-side)<br/>injects API key - rate-limit - cache"]

    subgraph backend["API service: builds transactions, stateless, no keys"]
        direction TB
        analysis["Account analysis<br/>aggregator"]
        close["Close builder<br/>(minimal unsigned tx set)"]
        defi["DeFi position adapter<br/>(OctoPos)"]
        route["Routing service<br/>(Soroswap + SDEX paths)"]
        med["Mediator co-sign<br/>(forward payment only)"]
        reg["Exchange + contract<br/>registries"]
        cache["Cache (short TTL)"]
    end

    subgraph data["Stellar network and data services"]
        direction TB
        rpc["Stellar RPC<br/>(reads, simulate, submit, events)"]
        idx["Horizon-compatible provider<br/>(set by configuration)"]
        soro["Soroswap Aggregator API"]
        pos["DeFi Position API<br/>(OctoPos)"]
        net["Stellar ledger<br/>(classic + Soroban)"]
    end

    close -->|"unsigned XDR"| verify
    verify -->|"if intent matches"| signer
    wk --> signer
    sk --> signer
    signer --> sess

    ui -->|"fetch plan + tx"| proxy
    proxy -->|"read + build (key injected)"| analysis
    proxy --> close
    signer -->|"signed XDR -> submit"| proxy
    proxy -->|"mediator co-sign"| med

    close --> analysis
    analysis --> idx
    analysis --> rpc
    analysis --> defi
    close --> rpc
    defi --> pos
    route --> soro
    route --> idx
    med --> rpc
    analysis --> cache

    rpc --> net
    idx --> net
    soro --> net
    pos --> net
